@namespace YpsAdmin.Web.Components

@if (IsLoading)
{
    <div class="p-12 text-center flex flex-col items-center justify-center space-y-3 min-h-[220px]" role="status" aria-live="polite">
        <svg class="w-8 h-8 text-primary animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
        <p class="text-xs font-bold text-muted-foreground tracking-wider uppercase font-mono">@LoadingText</p>
    </div>
}
else if (HasError)
{
    <div class="p-8 text-center flex flex-col items-center justify-center space-y-3 bg-destructive/10 border-2 border-destructive/30 rounded-2xl m-4 shadow-xs" role="alert">
        <div class="w-10 h-10 rounded-full bg-destructive/20 border border-destructive/30 flex items-center justify-center text-destructive">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
        </div>
        <div class="space-y-1 max-w-md">
            <h4 class="text-sm font-extrabold text-foreground">@ErrorTitle</h4>
            <p class="text-xs text-muted-foreground">@(ErrorMessage ?? "An unexpected error occurred while fetching data.")</p>
        </div>
        @if (OnRetry.HasDelegate)
        {
            <div class="pt-2">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="OnRetry">
                    <svg class="w-3.5 h-3.5 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>
                    </svg>
                    Retry Loading
                </Button>
            </div>
        }
    </div>
}
else if (IsEmpty)
{
    <div class="p-12 text-center flex flex-col items-center justify-center space-y-3 min-h-[220px]">
        <div class="w-12 h-12 rounded-full bg-muted border-2 border-border flex items-center justify-center text-muted-foreground">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
            </svg>
        </div>
        <div class="space-y-1 max-w-sm">
            <h4 class="text-sm font-extrabold text-foreground">@EmptyTitle</h4>
            <p class="text-xs text-muted-foreground">@EmptyDescription</p>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading data...";

    [Parameter] public bool HasError { get; set; }
    [Parameter] public string ErrorTitle { get; set; } = "Unable to load content";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No records found";
    [Parameter] public string EmptyDescription { get; set; } = "There is no data to display for this view.";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
