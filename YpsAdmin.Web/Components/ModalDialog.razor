@namespace YpsAdmin.Web.Components

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto bg-slate-950/50 backdrop-blur-xs animate-fade-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @onclick="OnBackdropClick">

        <div class="bg-card rounded-2xl border-2 border-border shadow-[5px_5px_0px_var(--shadow-hard)] @(string.IsNullOrEmpty(MaxWidthClass) ? "max-w-lg" : MaxWidthClass) w-full p-6 space-y-5 animate-fade-in my-8 text-card-foreground"
             @onclick:stopPropagation="true"
             role="dialog"
             aria-modal="true"
             aria-labelledby="modal-title">

            <!-- Header -->
            <div class="flex items-start justify-between border-b-2 border-border pb-3.5">
                <div>
                    <h3 id="modal-title" class="text-base font-extrabold text-foreground tracking-tight">@Title</h3>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="text-xs text-muted-foreground mt-0.5">@Description</p>
                    }
                </div>
                <button type="button" @onclick="CloseModal" class="text-muted-foreground hover:text-foreground p-1.5 rounded-full hover:bg-accent border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Close dialog">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                    </svg>
                    <span class="sr-only">Close modal</span>
                </button>
            </div>

            <!-- Body -->
            <div class="space-y-4">
                @ChildContent
            </div>

            <!-- Footer -->
            @if (Footer != null)
            {
                <div class="flex items-center justify-end gap-2.5 pt-3.5 border-t border-border">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string MaxWidthClass { get; set; } = "max-w-lg";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task OnBackdropClick()
    {
        if (CloseOnBackdrop)
        {
            await CloseModal();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseModal();
        }
    }
}
