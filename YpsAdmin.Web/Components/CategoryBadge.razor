@namespace YpsAdmin.Web.Components

<span class="@GetBadgeClass()">
    @if (ShowDot)
    {
        <span class="w-1.5 h-1.5 rounded-full bg-current opacity-80 mr-1.5 inline-block" aria-hidden="true"></span>
    }
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;
    [Parameter] public bool ShowDot { get; set; } = false;

    public enum BadgeVariant
    {
        Default,
        TopUp,
        Retail,
        ServiceCenter,
        YpsAccepted,
        Outline,
        Route,
        Gps,
        Danger
    }

    private string GetBadgeClass()
    {
        var baseClasses = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-tight transition-colors border select-none font-mono";

        var variantClasses = Variant switch
        {
            BadgeVariant.YpsAccepted => "bg-[#FFF1A8] text-[#6B5600] border-[#6B5600]/20",
            BadgeVariant.Retail => "bg-[#FFE3DA] text-[#A23F2B] border-[#A23F2B]/20",
            BadgeVariant.TopUp => "bg-[#DCEEFF] text-[#0B5F9B] border-[#0B5F9B]/20",
            BadgeVariant.ServiceCenter => "bg-[#DFF7EC] text-[#137455] border-[#137455]/20",
            BadgeVariant.Route => "bg-[#EEE7FF] text-[#6546AD] border-[#6546AD]/20",
            BadgeVariant.Gps => "bg-[#DFF7EC] text-[#137455] border-[#137455]/20",
            BadgeVariant.Danger => "bg-[#FFE3EF] text-[#A83D69] border-[#A83D69]/20",
            BadgeVariant.Outline => "bg-transparent text-muted-foreground border-border",
            _ => "bg-muted text-foreground border-border"
        };

        return $"{baseClasses} {variantClasses}".Trim();
    }

    public static BadgeVariant ResolveStoreCategoryVariant(string? category)
    {
        if (string.IsNullOrWhiteSpace(category)) return BadgeVariant.Default;
        var catLower = category.ToLowerInvariant();
        if (catLower.Contains("top") || catLower.Contains("recharge")) return BadgeVariant.TopUp;
        if (catLower.Contains("retail") || catLower.Contains("shop") || catLower.Contains("store")) return BadgeVariant.Retail;
        if (catLower.Contains("service") || catLower.Contains("center")) return BadgeVariant.ServiceCenter;
        return BadgeVariant.Default;
    }
}
