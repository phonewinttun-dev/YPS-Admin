@inherits LayoutComponentBase
@inject LanguageService Lang
@implements IDisposable

<a href="#main-content" class="sr-only-focusable fixed top-2 left-2 z-50 bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium text-xs shadow-md focus:not-sr-only focus:outline-none focus:ring-2 focus:ring-ring">
    Skip to main content
</a>

<ToastNotification />

<div class="min-h-screen flex flex-col md:flex-row bg-background text-foreground font-sans">
    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-card border-r border-border flex flex-col justify-between shrink-0 shadow-xs" aria-label="Sidebar Navigation">
        <div>
            <!-- Header Brand -->
            <div class="p-4 border-b border-border flex items-center justify-between">
                <a href="/" class="flex items-center gap-2.5 text-foreground font-bold text-base tracking-tight hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-md">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[#FFF1A8] text-[#6B5600] border border-[#6B5600]/20 font-bold text-xs shadow-xs font-mono">
                        YPS
                    </span>
                    <span class="font-semibold text-sm">@Lang.GetText("AppTitle")</span>
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="p-3 space-y-1" aria-label="Main Navigation">
                <NavLink href="bus-lines" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                    <span>@Lang.GetText("NavBusLines")</span>
                </NavLink>

                <NavLink href="bus-stops" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>@Lang.GetText("NavBusStops")</span>
                </NavLink>

                <NavLink href="route-stops" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.818V8.049a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                    </svg>
                    <span>@Lang.GetText("NavRouteMapping")</span>
                </NavLink>

                <NavLink href="yps-stores" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                    </svg>
                    <span>@Lang.GetText("NavYpsStores")</span>
                </NavLink>
            </nav>
        </div>

        <!-- Footer & Language Switcher -->
        <div class="p-3.5 border-t border-border bg-muted/40">
            <div class="text-2xs text-muted-foreground mb-2 font-mono tracking-wider uppercase">Language / ဘာသာစကား</div>
            <div class="flex items-center gap-1.5 bg-muted p-1 rounded-lg border border-border">
                <button type="button" 
                        @onclick='() => SetLang("en")' 
                        class="flex-1 py-1 px-2.5 text-xs font-semibold rounded-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring @(Lang.CurrentLanguage == "en" ? "bg-card text-foreground shadow-xs" : "text-muted-foreground hover:text-foreground")">
                    English
                </button>
                <button type="button" 
                        @onclick='() => SetLang("my")' 
                        class="flex-1 py-1 px-2.5 text-xs font-semibold rounded-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring @(Lang.CurrentLanguage == "my" ? "bg-card text-foreground shadow-xs" : "text-muted-foreground hover:text-foreground")">
                    မြန်မာ
                </button>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 flex flex-col min-w-0" tabindex="-1">
        <!-- Top App Bar with Persistent Breadcrumb -->
        <header class="h-14 bg-card border-b border-border px-6 flex items-center justify-between shadow-xs">
            <Breadcrumb />
            <div class="text-xs font-mono text-muted-foreground bg-muted px-2 py-0.5 rounded border border-border">YPS Admin v1.1</div>
        </header>

        <!-- Dynamic Body Page -->
        <div class="p-6 flex-1 overflow-y-auto">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await Lang.InitializeAsync();
    }

    private async Task SetLang(string langCode)
    {
        await Lang.SetLanguageAsync(langCode);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
