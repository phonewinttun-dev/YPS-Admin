@inherits LayoutComponentBase
@inject LanguageService Lang
@inject ThemeService Theme
@implements IDisposable

<ToastNotification />

<div class="h-screen w-screen flex flex-col md:flex-row bg-background text-foreground font-sans transition-colors duration-200 overflow-hidden">
    <!-- Sidebar Navigation: Fixed left column with sticky bottom controls -->
    <aside class="w-full md:w-64 h-auto md:h-full bg-card border-r-2 border-border flex flex-col justify-between shrink-0 shadow-[2px_0px_0px_var(--shadow-hard)] z-30 overflow-y-auto" aria-label="Sidebar Navigation">
        <div>
            <!-- Header Brand -->
            <div class="p-4 border-b-2 border-border flex items-center justify-between shrink-0">
                <a href="/" class="flex items-center gap-2.5 text-foreground font-extrabold text-base tracking-tight hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-lg">
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-primary text-primary-foreground border-2 border-border font-extrabold text-xs shadow-xs font-mono-numbers">
                        YPS
                    </span>
                    <span class="font-extrabold text-sm tracking-wide">@Lang.GetText("AppTitle")</span>
                </a>
            </div>

            <!-- Navigation Links with reUI SVG Icons -->
            <nav class="p-3 space-y-1.5" aria-label="Main Navigation">
                <NavLink href="dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs font-bold text-muted-foreground hover:bg-accent hover:text-foreground border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&.active]:bg-primary [&.active]:text-primary-foreground [&.active]:border-border [&.active]:shadow-[2px_2px_0px_var(--shadow-hard)]" Match="NavLinkMatch.All">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
                    </svg>
                    <span>@Lang.GetText("NavDashboard")</span>
                </NavLink>

                <NavLink href="bus-lines" class="flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs font-bold text-muted-foreground hover:bg-accent hover:text-foreground border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&.active]:bg-primary [&.active]:text-primary-foreground [&.active]:border-border [&.active]:shadow-[2px_2px_0px_var(--shadow-hard)]" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/>
                    </svg>
                    <span>@Lang.GetText("NavBusLines")</span>
                </NavLink>

                <NavLink href="bus-stops" class="flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs font-bold text-muted-foreground hover:bg-accent hover:text-foreground border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&.active]:bg-primary [&.active]:text-primary-foreground [&.active]:border-border [&.active]:shadow-[2px_2px_0px_var(--shadow-hard)]" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>@Lang.GetText("NavBusStops")</span>
                </NavLink>

                <NavLink href="route-stops" class="flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs font-bold text-muted-foreground hover:bg-accent hover:text-foreground border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&.active]:bg-primary [&.active]:text-primary-foreground [&.active]:border-border [&.active]:shadow-[2px_2px_0px_var(--shadow-hard)]" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>
                    </svg>
                    <span>@Lang.GetText("NavRouteMapping")</span>
                </NavLink>

                <NavLink href="yps-stores" class="flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs font-bold text-muted-foreground hover:bg-accent hover:text-foreground border border-transparent hover:border-border transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&.active]:bg-primary [&.active]:text-primary-foreground [&.active]:border-border [&.active]:shadow-[2px_2px_0px_var(--shadow-hard)]" Match="NavLinkMatch.Prefix">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
                    </svg>
                    <span>@Lang.GetText("NavYpsStores")</span>
                </NavLink>
            </nav>
        </div>

    </aside>

    <!-- Main Content Area: Header at top, independent scrolling on body -->
    <main id="main-content" class="flex-1 flex flex-col h-full min-w-0 overflow-hidden" tabindex="-1">
        <!-- Top App Bar with Persistent Breadcrumb, Language Toggle & Theme Toggle -->
        <header class="h-14 bg-card border-b-2 border-border px-6 flex items-center justify-between shadow-xs shrink-0 z-20">
            <Breadcrumb />
            
            <div class="flex items-center gap-2">
                <!-- Language Toggle Button with reUI Languages SVG Icon -->
                <button type="button"
                        @onclick="ToggleLanguage"
                        class="h-9 px-3 rounded-full border-2 border-border text-foreground hover:bg-accent transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer shadow-xs flex items-center gap-1.5 text-xs font-bold font-mono"
                        title="@(Lang.CurrentLanguage == "en" ? "Switch to Myanmar" : "Switch to English")"
                        aria-label="Toggle language">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 8 6 6"/>
                        <path d="m4 14 6-6 2-3"/>
                        <path d="M2 5h12"/>
                        <path d="M7 2h1"/>
                        <path d="m22 22-5-10-5 10"/>
                        <path d="M14 18h6"/>
                    </svg>
                    <span>@(Lang.CurrentLanguage == "en" ? "EN" : "မြန်မာ")</span>
                </button>

                <!-- Theme Toggle Button with reUI Sun/Moon SVG Icons -->
                <button type="button"
                        @onclick="ToggleTheme"
                        class="h-9 w-9 p-0 rounded-full border-2 border-border text-foreground hover:bg-accent transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer shadow-xs flex items-center justify-center shrink-0"
                        title="@(Theme.IsDark ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        aria-label="Toggle theme">
                    @if (Theme.IsDark)
                    {
                        <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                        </svg>
                    }
                    else
                    {
                        <svg class="w-4 h-4 text-bus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                        </svg>
                    }
                </button>
            </div>
        </header>

        <!-- Body Viewport: Scrollable -->
        <div class="flex-1 overflow-y-auto p-4 md:p-6 bg-canvas">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        Theme.OnThemeChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            await Lang.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleThemeAsync();
    }

    private async Task ToggleLanguage()
    {
        var nextLang = Lang.CurrentLanguage == "en" ? "my" : "en";
        await Lang.SetLanguageAsync(nextLang);
    }

    private async Task SetLang(string langCode)
    {
        await Lang.SetLanguageAsync(langCode);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        Theme.OnThemeChanged -= StateHasChanged;
    }
}
