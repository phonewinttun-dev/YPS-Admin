@page "/dashboard"
@inject IDashboardService DashboardService
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

<div class="space-y-6 max-w-7xl mx-auto" role="region" aria-label="@Lang.GetText("NavDashboard")">
    <!-- Header Section -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-card p-5 rounded-2xl border border-border shadow-xs">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-brand-bg text-brand border border-brand/20 font-bold text-xs shadow-xs font-mono" aria-hidden="true">
                    YPS
                </span>
                <h1 id="dashboard-heading" class="text-lg md:text-xl font-bold text-foreground tracking-tight">
                    @Lang.GetText("DashboardTitle")
                </h1>
            </div>
            <p class="text-xs text-muted-foreground mt-1">
                @Lang.GetText("DashboardSubtitle")
            </p>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-mono">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                @Lang.GetText("Operational")
            </span>
            <button type="button"
                    @onclick="LoadDashboardAsync"
                    class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 py-2 text-xs font-medium rounded-lg bg-secondary text-secondary-foreground hover:bg-accent hover:text-accent-foreground border border-border transition-colors shadow-xs cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    aria-label="Refresh dashboard data">
                <svg class="w-4 h-4 mr-1.5 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                <span>@(isLoading ? Lang.GetText("Loading") : Lang.GetText("Refresh"))</span>
            </button>
        </div>
    </header>

    <!-- StateView Wrapper for Loading / Error / Empty States -->
    <StateView IsLoading="@isLoading"
               HasError="@hasError"
               ErrorMessage="@errorMessage"
               OnRetry="LoadDashboardAsync"
               IsEmpty="@(summary == null)"
               EmptyTitle="@Lang.GetText("NoDataFound")"
               EmptyDescription="Dashboard summary is currently unavailable.">
        <ChildContent>
            @if (summary != null)
            {
                <div class="space-y-6" aria-live="polite">
                    <!-- Primary KPIs (3 Core Pillars) -->
                    <section aria-labelledby="primary-metrics-heading">
                        <h2 id="primary-metrics-heading" class="sr-only">Primary Key Performance Indicators</h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            
                            <!-- 1. Total Bus Lines (Sky Blue / Bus Theme) -->
                            <div class="group relative bg-card hover:bg-accent/30 rounded-2xl border border-border p-5 shadow-xs transition-all hover:shadow-md flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                            @Lang.GetText("TotalBusLines")
                                        </p>
                                        <h3 class="text-3xl md:text-4xl font-bold font-mono text-foreground mt-2">
                                            @summary.TotalBusLines.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-12 h-12 rounded-xl bg-bus-bg text-bus border border-bus/30 flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-4 border-t border-border/60 flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        @summary.TotalCardAcceptedBuses @Lang.GetText("CardAccepted")
                                    </span>
                                    <a href="bus-lines" 
                                       class="inline-flex items-center min-h-[44px] px-2 text-xs font-semibold text-primary hover:text-primary/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-md"
                                       aria-label="@Lang.GetText("ManageBusLines") - @summary.TotalBusLines @Lang.GetText("TotalBusLines")">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- 2. Total Bus Stops (Mint / GPS Theme) -->
                            <div class="group relative bg-card hover:bg-accent/30 rounded-2xl border border-border p-5 shadow-xs transition-all hover:shadow-md flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                            @Lang.GetText("TotalBusStops")
                                        </p>
                                        <h3 class="text-3xl md:text-4xl font-bold font-mono text-foreground mt-2">
                                            @summary.TotalBusStops.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-12 h-12 rounded-xl bg-gps-bg text-gps border border-gps/30 flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-4 border-t border-border/60 flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        @summary.TotalRegions @Lang.GetText("TotalTownships")
                                    </span>
                                    <a href="bus-stops" 
                                       class="inline-flex items-center min-h-[44px] px-2 text-xs font-semibold text-gps hover:opacity-80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-md"
                                       aria-label="@Lang.GetText("ManageBusStops") - @summary.TotalBusStops @Lang.GetText("TotalBusStops")">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- 3. Total YPS Stores (Coral / Store Theme) -->
                            <div class="group relative bg-card hover:bg-accent/30 rounded-2xl border border-border p-5 shadow-xs transition-all hover:shadow-md flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                            @Lang.GetText("TotalYpsStores")
                                        </p>
                                        <h3 class="text-3xl md:text-4xl font-bold font-mono text-foreground mt-2">
                                            @summary.TotalStores.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-12 h-12 rounded-xl bg-store-bg text-store border border-store/30 flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-4 border-t border-border/60 flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        Top-up &amp; Card Retail
                                    </span>
                                    <a href="yps-stores" 
                                       class="inline-flex items-center min-h-[44px] px-2 text-xs font-semibold text-store hover:opacity-80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-md"
                                       aria-label="@Lang.GetText("ManageYpsStores") - @summary.TotalStores @Lang.GetText("TotalYpsStores")">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </section>

                    <!-- Secondary Network Indicators & Breakdown -->
                    <section aria-labelledby="network-breakdown-heading">
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                            
                            <!-- Card Acceptance Rate -->
                            <div class="bg-card rounded-2xl border border-border p-5 shadow-xs flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 id="network-breakdown-heading" class="text-sm font-semibold text-foreground">
                                            @Lang.GetText("CardAcceptedBuses")
                                        </h3>
                                        <CategoryBadge Text="@($"{GetCardPercentage()}%")" Variant="CategoryBadge.BadgeVariant.YpsAccepted" ShowDot="true" />
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Proportion of active bus fleet equipped with YPS smart card payment.
                                    </p>
                                </div>
                                <div>
                                    <div class="w-full h-2.5 bg-muted rounded-full overflow-hidden" role="progressbar" aria-valuenow="@GetCardPercentage()" aria-valuemin="0" aria-valuemax="100" aria-label="Card Acceptance Progress">
                                        <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: @(GetCardPercentage())%;"></div>
                                    </div>
                                    <div class="flex justify-between items-center mt-2 text-2xs text-muted-foreground font-mono">
                                        <span>@summary.TotalCardAcceptedBuses @Lang.GetText("CardAccepted")</span>
                                        <span>@summary.TotalBusLines Total</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Covered Townships / Operational Regions -->
                            <div class="bg-card rounded-2xl border border-border p-5 shadow-xs flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 class="text-sm font-semibold text-foreground">
                                            @Lang.GetText("TotalTownships")
                                        </h3>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-muted text-foreground border border-border">
                                            Yangon Division
                                        </span>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Active administrative townships with registered bus stops or stores.
                                    </p>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold font-mono text-foreground">@summary.TotalRegions</span>
                                    <span class="text-xs text-muted-foreground">Townships &amp; Regions</span>
                                </div>
                            </div>

                            <!-- Active Route Stop Sequences -->
                            <div class="bg-card rounded-2xl border border-border p-5 shadow-xs flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 class="text-sm font-semibold text-foreground">
                                            @Lang.GetText("TotalRouteMappings")
                                        </h3>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-route-bg text-route border border-route/30">
                                            Mapped
                                        </span>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Stop-to-route sequence links configured across outbound &amp; return routes.
                                    </p>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold font-mono text-foreground">@summary.TotalRouteMappings.ToString("N0")</span>
                                    <span class="text-xs text-muted-foreground">Stop Connections</span>
                                </div>
                            </div>

                        </div>
                    </section>

                    <!-- Quick Management Actions Grid -->
                    <section aria-labelledby="quick-actions-heading" class="bg-card rounded-2xl border border-border p-5 shadow-xs">
                        <div class="mb-4">
                            <h2 id="quick-actions-heading" class="text-sm font-semibold text-foreground">
                                @Lang.GetText("QuickActions")
                            </h2>
                            <p class="text-xs text-muted-foreground mt-0.5">
                                Direct shortcuts to administrative modules and data registers.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                            
                            <!-- Bus Lines Link -->
                            <a href="bus-lines" class="flex items-center gap-3.5 p-3.5 rounded-xl border border-border bg-background hover:bg-accent/40 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-lg bg-bus-bg text-bus border border-bus/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors truncate">
                                        @Lang.GetText("NavBusLines")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground truncate">
                                        @summary.TotalBusLines routes
                                    </p>
                                </div>
                            </a>

                            <!-- Bus Stops Link -->
                            <a href="bus-stops" class="flex items-center gap-3.5 p-3.5 rounded-xl border border-border bg-background hover:bg-accent/40 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-lg bg-gps-bg text-gps border border-gps/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-semibold text-foreground group-hover:text-gps transition-colors truncate">
                                        @Lang.GetText("NavBusStops")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground truncate">
                                        @summary.TotalBusStops locations
                                    </p>
                                </div>
                            </a>

                            <!-- Route Mapping Link -->
                            <a href="route-stops" class="flex items-center gap-3.5 p-3.5 rounded-xl border border-border bg-background hover:bg-accent/40 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-lg bg-route-bg text-route border border-route/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.818V8.049a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-semibold text-foreground group-hover:text-route transition-colors truncate">
                                        @Lang.GetText("NavRouteMapping")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground truncate">
                                        Sequence &amp; Map
                                    </p>
                                </div>
                            </a>

                            <!-- YPS Stores Link -->
                            <a href="yps-stores" class="flex items-center gap-3.5 p-3.5 rounded-xl border border-border bg-background hover:bg-accent/40 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-lg bg-store-bg text-store border border-store/30 flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-semibold text-foreground group-hover:text-store transition-colors truncate">
                                        @Lang.GetText("NavYpsStores")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground truncate">
                                        @summary.TotalStores stores
                                    </p>
                                </div>
                            </a>

                        </div>
                    </section>
                </div>
            }
        </ChildContent>
    </StateView>
</div>

@code {
    private DashboardSummaryDto? summary;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;

        try
        {
            var res = await DashboardService.GetDashboardSummaryAsync();
            if (res != null && res.IsSuccess && res.Data != null)
            {
                summary = res.Data;
            }
            else
            {
                hasError = true;
                errorMessage = res?.Message ?? "Failed to load dashboard summary.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetCardPercentage()
    {
        if (summary == null || summary.TotalBusLines <= 0) return 0;
        return (int)Math.Round((double)summary.TotalCardAcceptedBuses / summary.TotalBusLines * 100);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
