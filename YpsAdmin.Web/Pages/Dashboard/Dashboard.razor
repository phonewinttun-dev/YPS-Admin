@page "/dashboard"
@inject IDashboardService DashboardService
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

<div class="space-y-6 max-w-7xl mx-auto" role="region" aria-label="@Lang.GetText("NavDashboard")">
    <!-- Header Section -->
    <header class="brutalist-card p-5">
        <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-primary text-primary-foreground border-2 border-border font-extrabold text-xs shadow-xs font-mono-numbers" aria-hidden="true">
                YPS
            </span>
            <h1 id="dashboard-heading" class="text-lg md:text-xl font-extrabold text-foreground tracking-tight">
                @Lang.GetText("DashboardTitle")
            </h1>
        </div>
        <p class="text-xs text-muted-foreground mt-1">
            @Lang.GetText("DashboardSubtitle")
        </p>
    </header>

    <!-- StateView Wrapper for Loading / Error / Empty States -->
    <StateView IsLoading="@isLoading"
               HasError="@hasError"
               ErrorMessage="@errorMessage"
               OnRetry="LoadDashboardAsync"
               IsEmpty="@(summary == null)"
               EmptyTitle="@Lang.GetText("NoDataFound")"
               EmptyDescription="Dashboard summary is currently unavailable.">
        <ChildContent>
            @if (summary != null)
            {
                <div class="space-y-6" aria-live="polite">
                    <!-- Primary KPIs (4 Swiss Brutalist Metric Cards) -->
                    <section aria-labelledby="primary-metrics-heading">
                        <h2 id="primary-metrics-heading" class="sr-only">Primary Key Performance Indicators</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            
                            <!-- 1. Total Bus Lines -->
                            <div class="brutalist-card brutalist-card-interactive p-5 flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-2xs font-extrabold text-muted-foreground uppercase tracking-wider font-mono">
                                            @Lang.GetText("TotalBusLines")
                                        </p>
                                        <h3 class="text-3xl font-extrabold font-mono-numbers text-foreground mt-2">
                                            @summary.TotalBusLines.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-10 h-10 rounded-full bg-bus-bg text-bus border-2 border-border flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t-2 border-border flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        @summary.TotalCardAcceptedBuses @Lang.GetText("CardAccepted")
                                    </span>
                                    <a href="bus-lines" 
                                       class="inline-flex items-center text-xs font-bold text-bus hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                       aria-label="@Lang.GetText("ManageBusLines") - @summary.TotalBusLines">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- 2. Total Bus Stops -->
                            <div class="brutalist-card brutalist-card-interactive p-5 flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-2xs font-extrabold text-muted-foreground uppercase tracking-wider font-mono">
                                            @Lang.GetText("TotalBusStops")
                                        </p>
                                        <h3 class="text-3xl font-extrabold font-mono-numbers text-foreground mt-2">
                                            @summary.TotalBusStops.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-10 h-10 rounded-full bg-gps-bg text-gps border-2 border-border flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t-2 border-border flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        @summary.TotalRegions @Lang.GetText("TotalTownships")
                                    </span>
                                    <a href="bus-stops" 
                                       class="inline-flex items-center text-xs font-bold text-gps hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                       aria-label="@Lang.GetText("ManageBusStops") - @summary.TotalBusStops">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- 3. Card Acceptance Rate -->
                            <div class="brutalist-card brutalist-card-interactive p-5 flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-2xs font-extrabold text-muted-foreground uppercase tracking-wider font-mono">
                                            @Lang.GetText("CardAcceptedBuses")
                                        </p>
                                        <h3 class="text-3xl font-extrabold font-mono-numbers text-foreground mt-2">
                                            @GetCardPercentage()%
                                        </h3>
                                    </div>
                                    <div class="w-10 h-10 rounded-full bg-brand-bg text-brand border-2 border-border flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t-2 border-border flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        @summary.TotalCardAcceptedBuses of @summary.TotalBusLines Fleet
                                    </span>
                                    <span class="text-xs font-bold text-brand">Active</span>
                                </div>
                            </div>

                            <!-- 4. Total YPS Stores -->
                            <div class="brutalist-card brutalist-card-interactive p-5 flex flex-col justify-between">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-2xs font-extrabold text-muted-foreground uppercase tracking-wider font-mono">
                                            @Lang.GetText("TotalYpsStores")
                                        </p>
                                        <h3 class="text-3xl font-extrabold font-mono-numbers text-foreground mt-2">
                                            @summary.TotalStores.ToString("N0")
                                        </h3>
                                    </div>
                                    <div class="w-10 h-10 rounded-full bg-store-bg text-store border-2 border-border flex items-center justify-center shadow-xs shrink-0" aria-hidden="true">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t-2 border-border flex items-center justify-between">
                                    <span class="text-2xs text-muted-foreground font-mono">
                                        Top-up &amp; Card Retail
                                    </span>
                                    <a href="yps-stores" 
                                       class="inline-flex items-center text-xs font-bold text-store hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                       aria-label="@Lang.GetText("ManageYpsStores") - @summary.TotalStores">
                                        <span>@Lang.GetText("ViewAll")</span>
                                        <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </section>

                    <!-- Secondary Network Indicators & Breakdown -->
                    <section aria-labelledby="network-breakdown-heading">
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                            
                            <!-- Card Acceptance Rate Progress -->
                            <div class="brutalist-card p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <h3 id="network-breakdown-heading" class="text-xs font-extrabold uppercase tracking-wider text-foreground font-mono">
                                            @Lang.GetText("CardAcceptedBuses")
                                        </h3>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-2xs font-extrabold font-mono bg-brand-bg text-brand border border-brand/40 shadow-xs">
                                            @GetCardPercentage()%
                                        </span>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Proportion of active bus fleet equipped with YPS smart card contactless readers.
                                    </p>
                                </div>
                                <div>
                                    <div class="w-full h-3 bg-muted border-2 border-border rounded-full overflow-hidden" role="progressbar" aria-valuenow="@GetCardPercentage()" aria-valuemin="0" aria-valuemax="100" aria-label="Card Acceptance Progress">
                                        <div class="h-full bg-brand rounded-full transition-all duration-500" style="width: @(GetCardPercentage())%;"></div>
                                    </div>
                                    <div class="flex justify-between items-center mt-2 text-2xs text-muted-foreground font-mono">
                                        <span>@summary.TotalCardAcceptedBuses @Lang.GetText("CardAccepted")</span>
                                        <span>@summary.TotalBusLines Total Lines</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Covered Townships / Operational Regions -->
                            <div class="brutalist-card p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <h3 class="text-xs font-extrabold uppercase tracking-wider text-foreground font-mono">
                                            @Lang.GetText("TotalTownships")
                                        </h3>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-2xs font-extrabold font-mono bg-muted text-foreground border border-border shadow-xs">
                                            Yangon Division
                                        </span>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Administrative townships with registered bus stops, route checkpoints, or sales points.
                                    </p>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-extrabold font-mono-numbers text-foreground">@summary.TotalRegions</span>
                                    <span class="text-xs text-muted-foreground font-bold">Townships &amp; Regions</span>
                                </div>
                            </div>

                            <!-- Active Route Stop Sequences -->
                            <div class="brutalist-card p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <h3 class="text-xs font-extrabold uppercase tracking-wider text-foreground font-mono">
                                            @Lang.GetText("TotalRouteMappings")
                                        </h3>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-2xs font-extrabold font-mono bg-bus-bg text-bus border border-bus/40 shadow-xs">
                                            Sequenced
                                        </span>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-4">
                                        Stop-to-route sequence links configured across outbound &amp; return transit corridors.
                                    </p>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-extrabold font-mono-numbers text-foreground">@summary.TotalRouteMappings.ToString("N0")</span>
                                    <span class="text-xs text-muted-foreground font-bold">Stop Connections</span>
                                </div>
                            </div>

                        </div>
                    </section>

                    <!-- Quick Management Actions Grid -->
                    <section aria-labelledby="quick-actions-heading" class="brutalist-card p-5">
                        <div class="mb-4">
                            <h2 id="quick-actions-heading" class="text-sm font-extrabold text-foreground">
                                @Lang.GetText("QuickActions")
                            </h2>
                            <p class="text-xs text-muted-foreground mt-0.5">
                                Direct shortcuts to transit management modules and registry tables.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                            
                            <!-- Bus Lines Link -->
                            <a href="bus-lines" class="flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-border bg-card hover:bg-accent/60 transition-all shadow-[2px_2px_0px_var(--shadow-hard)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_var(--shadow-hard)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-full bg-bus-bg text-bus border-2 border-border flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-bold text-foreground group-hover:text-bus transition-colors truncate">
                                        @Lang.GetText("NavBusLines")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground font-mono truncate">
                                        @summary.TotalBusLines routes
                                    </p>
                                </div>
                            </a>

                            <!-- Bus Stops Link -->
                            <a href="bus-stops" class="flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-border bg-card hover:bg-accent/60 transition-all shadow-[2px_2px_0px_var(--shadow-hard)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_var(--shadow-hard)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-full bg-gps-bg text-gps border-2 border-border flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-bold text-foreground group-hover:text-gps transition-colors truncate">
                                        @Lang.GetText("NavBusStops")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground font-mono truncate">
                                        @summary.TotalBusStops locations
                                    </p>
                                </div>
                            </a>

                            <!-- Route Mapping Link -->
                            <a href="route-stops" class="flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-border bg-card hover:bg-accent/60 transition-all shadow-[2px_2px_0px_var(--shadow-hard)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_var(--shadow-hard)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-full bg-bus-bg text-bus border-2 border-border flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-bold text-foreground group-hover:text-bus transition-colors truncate">
                                        @Lang.GetText("NavRouteMapping")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground font-mono truncate">
                                        Sequence &amp; Map
                                    </p>
                                </div>
                            </a>

                            <!-- YPS Stores Link -->
                            <a href="yps-stores" class="flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-border bg-card hover:bg-accent/60 transition-all shadow-[2px_2px_0px_var(--shadow-hard)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_var(--shadow-hard)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring group min-h-[44px]">
                                <div class="w-10 h-10 rounded-full bg-store-bg text-store border-2 border-border flex items-center justify-center shrink-0" aria-hidden="true">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-xs font-bold text-foreground group-hover:text-store transition-colors truncate">
                                        @Lang.GetText("NavYpsStores")
                                    </h4>
                                    <p class="text-2xs text-muted-foreground font-mono truncate">
                                        @summary.TotalStores stores
                                    </p>
                                </div>
                            </a>

                        </div>
                    </section>
                </div>
            }
        </ChildContent>
    </StateView>
</div>

@code {
    private DashboardSummaryDto? summary;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;

        try
        {
            var res = await DashboardService.GetDashboardSummaryAsync();
            if (res != null && res.IsSuccess && res.Data != null)
            {
                summary = res.Data;
            }
            else
            {
                hasError = true;
                errorMessage = res?.Message ?? "Failed to load dashboard summary.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetCardPercentage()
    {
        if (summary == null || summary.TotalBusLines <= 0) return 0;
        return (int)Math.Round((double)summary.TotalCardAcceptedBuses / summary.TotalBusLines * 100);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
