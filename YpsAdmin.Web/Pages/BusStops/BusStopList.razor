@page "/bus-stops"
@inject IBusStopService BusStopService
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-md border border-outline-variant">
        <div>
            <h2 class="text-lg font-bold text-on-surface">@Lang.GetText("NavBusStops")</h2>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="flex items-center gap-2 flex-1 sm:w-64">
                <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="@Lang.GetText("Search")..." class="w-full h-10 px-3 py-2 text-sm border border-outline rounded-md focus:outline-none focus:border-secondary" />
            </div>
            <button type="button" @onclick="OpenCreateModal" class="h-10 px-4 bg-secondary text-white text-sm font-semibold rounded-md hover:bg-secondary/90 transition-colors whitespace-nowrap">
                + @Lang.GetText("Add")
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-md border border-outline-variant overflow-hidden">
        @if (isLoading)
        {
            <div class="p-8 text-center text-sm text-tertiary">Loading...</div>
        }
        else if (busStops == null || busStops.Data == null || !busStops.Data.Any())
        {
            <div class="p-8 text-center text-sm text-tertiary">No bus stops found.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-surface-container border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                            <th class="p-3">@Lang.GetText("StopId")</th>
                            <th class="p-3">@Lang.GetText("StopNameMM") / (EN)</th>
                            <th class="p-3">@Lang.GetText("TownshipMM") / (EN)</th>
                            <th class="p-3">@Lang.GetText("Road")</th>
                            <th class="p-3 text-right">@Lang.GetText("Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        @foreach (var item in busStops.Data)
                        {
                            <tr class="hover:bg-surface transition-colors">
                                <td class="p-3 font-mono font-medium text-secondary">@item.StopId</td>
                                <td class="p-3">
                                    <div class="font-semibold text-on-surface">@item.NameMm</div>
                                    <div class="text-xs text-tertiary font-mono">@item.NameEn</div>
                                </td>
                                <td class="p-3">
                                    <div class="text-on-surface">@item.TownshipMm</div>
                                    <div class="text-xs text-tertiary font-mono">@item.TownshipEn</div>
                                </td>
                                <td class="p-3 text-on-surface">@item.Road</td>
                                <td class="p-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button" @onclick="() => OpenEditModal(item)" class="px-2.5 py-1 text-xs font-medium text-secondary border border-secondary/30 rounded hover:bg-secondary/10 transition-colors">
                                            @Lang.GetText("Edit")
                                        </button>
                                        <button type="button" @onclick="() => PromptDelete(item)" class="px-2.5 py-1 text-xs font-medium text-red-700 border border-red-200 rounded hover:bg-red-50 transition-colors">
                                            @Lang.GetText("Delete")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-3 border-t border-outline-variant bg-surface-container flex items-center justify-between">
                <span class="text-xs text-tertiary">Page @pageNumber of @busStops.Pagination.TotalPages (@busStops.Pagination.TotalCount items)</span>
                <div class="flex items-center gap-2">
                    <button type="button" disabled="@(!busStops.Pagination.HasPreviousPage)" @onclick="PreviousPage" class="px-3 py-1 text-xs font-medium bg-white border border-outline rounded disabled:opacity-40 hover:bg-surface-container-high transition-colors">
                        @Lang.GetText("Previous")
                    </button>
                    <button type="button" disabled="@(!busStops.Pagination.HasNextPage)" @onclick="NextPage" class="px-3 py-1 text-xs font-medium bg-white border border-outline rounded disabled:opacity-40 hover:bg-surface-container-high transition-colors">
                        @Lang.GetText("Next")
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create / Edit Form Modal -->
@if (showFormModal)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-md w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-on-surface border-b border-outline-variant pb-2">
                @(editingId.HasValue ? Lang.GetText("Edit") : Lang.GetText("Add")) @Lang.GetText("NavBusStops")
            </h3>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("StopId")</label>
                    <input type="text" @bind="formStopId" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("StopNameMM")</label>
                        <input type="text" @bind="formNameMm" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("StopNameEN")</label>
                        <input type="text" @bind="formNameEn" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("TownshipMM")</label>
                        <input type="text" @bind="formTownshipMm" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("TownshipEN")</label>
                        <input type="text" @bind="formTownshipEn" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("Road")</label>
                    <input type="text" @bind="formRoad" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" @onclick="CloseFormModal" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container transition-colors">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="SaveBusStop" class="px-4 py-1.5 text-xs font-semibold bg-secondary text-white rounded hover:bg-secondary/90 transition-colors">
                    @Lang.GetText("Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-sm w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-red-700">@Lang.GetText("ConfirmDeleteTitle")</h3>
            <p class="text-xs text-tertiary">@Lang.GetText("ConfirmDeleteMessage")</p>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="() => showDeleteModal = false" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="ConfirmDelete" class="px-4 py-1.5 text-xs font-semibold bg-red-700 text-white rounded hover:bg-red-800">
                    @Lang.GetText("Confirm")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<BusStopDto>? busStops;
    private bool isLoading = true;
    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state
    private bool showFormModal = false;
    private int? editingId = null;
    private string formStopId = "";
    private string formNameMm = "";
    private string formNameEn = "";
    private string formTownshipMm = "";
    private string formTownshipEn = "";
    private string formRoad = "";

    // Delete Modal state
    private bool showDeleteModal = false;
    private int? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            busStops = await BusStopService.GetBusStopsAsync(pageNumber, pageSize, searchQuery);
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        pageNumber = 1;
        await LoadData();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1) { pageNumber--; await LoadData(); }
    }

    private async Task NextPage()
    {
        if (busStops != null && busStops.Pagination.HasNextPage) { pageNumber++; await LoadData(); }
    }

    private void OpenCreateModal()
    {
        editingId = null;
        formStopId = "";
        formNameMm = "";
        formNameEn = "";
        formTownshipMm = "";
        formTownshipEn = "";
        formRoad = "";
        showFormModal = true;
    }

    private void OpenEditModal(BusStopDto item)
    {
        editingId = item.BusStopId;
        formStopId = item.StopId;
        formNameMm = item.NameMm;
        formNameEn = item.NameEn;
        formTownshipMm = item.TownshipMm;
        formTownshipEn = item.TownshipEn;
        formRoad = item.Road;
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
    }

    private async Task SaveBusStop()
    {
        if (editingId.HasValue)
        {
            var req = new UpdateBusStopRequest(formStopId, formNameMm, formNameEn, formTownshipMm, formTownshipEn, formRoad);
            await BusStopService.UpdateAsync(editingId.Value, req);
        }
        else
        {
            var req = new CreateBusStopRequest(formStopId, formNameMm, formNameEn, formTownshipMm, formTownshipEn, formRoad);
            await BusStopService.CreateAsync(req);
        }
        showFormModal = false;
        await LoadData();
    }

    private void PromptDelete(BusStopDto item)
    {
        deletingId = item.BusStopId;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (deletingId.HasValue)
        {
            await BusStopService.DeleteAsync(deletingId.Value);
            showDeleteModal = false;
            await LoadData();
        }
    }
}
