@page "/bus-stops"
@inject IBusStopService BusStopService
@inject IRegionService RegionService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-card p-4 rounded-xl border border-border shadow-xs">
        <div>
            <h2 class="text-base font-semibold text-foreground tracking-tight">@Lang.GetText("NavBusStops")</h2>
            <p class="text-xs text-muted-foreground mt-0.5">Manage bus stop stations, geographic regions, and GPS coordinates.</p>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-60 min-w-[180px]">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleSearch"
                       placeholder="@Lang.GetText("Search")..."
                       aria-label="Search bus stops"
                       class="w-full h-9 pl-9 pr-3 text-sm border border-input rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary shadow-xs transition-all" />
            </div>

            <div class="w-full sm:w-48">
                <AccessibleSelect TValue="int?"
                                  Value="@selectedRegionId"
                                  ValueChanged="HandleRegionFilterChanged"
                                  Items="@regionSelectItems"
                                  Placeholder="All Regions"
                                  AllowClear="true"
                                  AriaLabel="Filter by Region" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Wrapper -->
    <div class="bg-card rounded-xl border border-border shadow-xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(busStops == null || busStops.Data == null || !busStops.Data.Any())"
                   EmptyTitle="No bus stops found"
                   EmptyDescription="Try searching for a different stop name or region.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-muted/40 border-b border-border text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("StopName")</th>
                                <th class="p-3.5">@Lang.GetText("Region")</th>
                                <th class="p-3.5 font-mono">@Lang.GetText("Coordinates")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @if (busStops?.Data != null)
                            {
                                @foreach (var item in busStops.Data)
                                {
                                    <tr class="hover:bg-accent/40 transition-colors">
                                        <td class="p-3.5 font-semibold text-foreground">
                                            @item.StopName
                                        </td>
                                        <td class="p-3.5 text-foreground">
                                            @(item.RegionName ?? "Unassigned")
                                        </td>
                                        <td class="p-3.5 font-mono text-xs text-primary">
                                            @item.Lat.ToString("F6"), @item.Lon.ToString("F6")
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-destructive hover:bg-destructive/10 hover:text-destructive" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (busStops?.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@busStops.Pagination.TotalPages" TotalCount="@busStops.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Form Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavBusStops")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavBusStops")}")"
             Description="Enter bus stop name, region, and GPS coordinates.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-destructive/10 border border-destructive/20 rounded-md text-xs text-destructive flex items-center gap-2" role="alert">
                <svg class="w-4 h-4 shrink-0 text-destructive" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3.5">
            <div>
                <label class="block text-xs font-medium text-foreground mb-1">@Lang.GetText("StopName") *</label>
                <input type="text" @bind="formStopName" class="w-full h-9 px-3 text-sm border rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary shadow-xs @(!string.IsNullOrEmpty(formStopNameError) ? "border-destructive bg-destructive/5" : "border-input")" />
                @if (!string.IsNullOrEmpty(formStopNameError))
                {
                    <p class="text-2xs text-destructive mt-1">@formStopNameError</p>
                }
            </div>
            <div>
                <AccessibleSelect TValue="int?"
                                  Label="@Lang.GetText("Region")"
                                  @bind-Value="formRegionId"
                                  Items="@regionSelectItems"
                                  Placeholder="Select Region"
                                  AllowClear="true" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1">Latitude</label>
                    <input type="number" step="any" @bind="formLat" class="w-full h-9 px-3 text-sm border border-input rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary font-mono shadow-xs" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1">Longitude</label>
                    <input type="number" step="any" @bind="formLon" class="w-full h-9 px-3 text-sm border border-input rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary font-mono shadow-xs" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveBusStop">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Confirmation Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-muted-foreground">This will remove the bus stop and unassign it from any route mappings.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<BusStopDto>? busStops;
    private List<RegionDto>? regions;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";
    private int? selectedRegionId = null;

    private IEnumerable<SelectItem<int?>>? regionSelectItems => regions?.Select(r => new SelectItem<int?>(r.Id, r.RegionName));

    // Form Modal state & validation
    private bool showFormModal = false;
    private long? editingId = null;
    private string formStopName = "";
    private int? formRegionId = null;
    private double formLat = 16.8661;
    private double formLon = 96.1951;
    private string formValidationError = "";
    private string formStopNameError = "";

    // Delete Modal state
    private bool showDeleteModal = false;
    private long? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        var loadDataTask = LoadData();
        var regionsTask = RegionService.GetRegionsAsync(1, 200, null);

        await Task.WhenAll(loadDataTask, regionsTask);

        var rRes = await regionsTask;
        if (rRes?.Data != null) regions = rRes.Data;
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            if (selectedRegionId.HasValue && string.IsNullOrWhiteSpace(searchQuery))
            {
                var res = await BusStopService.GetBusStopByRegionAsync(selectedRegionId.Value);
                if (res != null && res.IsSuccess && res.Data != null)
                {
                    var items = res.Data;
                    var pagination = new YpsAdmin.Shared.Pagination(1, items.Count > 0 ? items.Count : 10, items.Count);
                    busStops = PagedResult<BusStopDto>.Success(items, pagination, res.Message);
                }
                else
                {
                    busStops = PagedResult<BusStopDto>.Failure(res?.Message ?? "Failed to load bus stops for region.");
                }
            }
            else
            {
                busStops = await BusStopService.GetBusStopsAsync(pageNumber, pageSize, searchQuery, selectedRegionId);
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleRegionFilterChanged(int? newRegionId)
    {
        selectedRegionId = newRegionId;
        pageNumber = 1;
        await LoadData();
    }

    private async Task HandleSearch() { pageNumber = 1; await LoadData(); }
    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private void OpenCreateModal()
    {
        editingId = null;
        formStopName = "";
        formRegionId = null;
        formLat = 16.8661;
        formLon = 96.1951;
        formValidationError = "";
        formStopNameError = "";
        showFormModal = true;
    }

    private void OpenEditModal(BusStopDto item)
    {
        editingId = item.Id;
        formStopName = item.StopName;
        formRegionId = item.RegionId;
        formLat = item.Lat;
        formLon = item.Lon;
        formValidationError = "";
        formStopNameError = "";
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveBusStop()
    {
        formValidationError = "";
        formStopNameError = "";

        if (string.IsNullOrWhiteSpace(formStopName))
        {
            formStopNameError = "Stop Name is required.";
            formValidationError = "Please fix validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateBusStopRequest(formStopName.Trim(), formLat, formLon, formRegionId, false);
                await BusStopService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess("Bus stop details updated successfully.");
            }
            else
            {
                var req = new CreateBusStopRequest(formStopName.Trim(), formLat, formLon, formRegionId);
                await BusStopService.CreateAsync(req);
                Toast.ShowSuccess("New bus stop added successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save bus stop: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(BusStopDto item)
    {
        deletingId = item.Id;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await BusStopService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Bus stop deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete bus stop: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
