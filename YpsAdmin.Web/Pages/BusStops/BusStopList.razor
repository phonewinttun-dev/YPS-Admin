@page "/bus-stops"
@inject IBusStopService BusStopService
@inject ITownshipService TownshipService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-lg border border-outline-variant shadow-2xs">
        <div>
            <h2 class="text-lg font-bold text-on-surface tracking-tight">@Lang.GetText("NavBusStops")</h2>
            <p class="text-xs text-tertiary">Manage bus stop stations, townships, roads, and locations.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-tertiary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleSearch"
                       placeholder="@Lang.GetText("Search")..."
                       class="w-full h-10 pl-9 pr-3 text-sm border border-outline-variant rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Wrapper -->
    <div class="bg-white rounded-lg border border-outline-variant shadow-2xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(busStops == null || busStops.Data == null || !busStops.Data.Any())"
                   EmptyTitle="No bus stops found"
                   EmptyDescription="Try searching for a different stop name or road name.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-surface-container/60 border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("StopNameMM") / (EN)</th>
                                <th class="p-3.5">@Lang.GetText("TownshipMM") / (EN)</th>
                                <th class="p-3.5">@Lang.GetText("Road")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">
                            @if (busStops != null && busStops.Data != null)
                            {
                                @foreach (var item in busStops.Data)
                                {
                                    <tr class="hover:bg-surface-container/30 transition-colors">
                                        <td class="p-3.5">
                                            <div class="font-semibold text-on-surface">@item.NameMm</div>
                                            @if (!string.IsNullOrEmpty(item.NameEn))
                                            {
                                                <div class="text-xs text-tertiary font-mono mt-0.5">@item.NameEn</div>
                                            }
                                        </td>
                                        <td class="p-3.5">
                                            <div class="text-on-surface">@item.TownshipNameMm</div>
                                            @if (!string.IsNullOrEmpty(item.TownshipNameEn))
                                            {
                                                <div class="text-xs text-tertiary font-mono mt-0.5">@item.TownshipNameEn</div>
                                            }
                                        </td>
                                        <td class="p-3.5 text-on-surface">
                                            @item.RoadMm
                                            @if (!string.IsNullOrEmpty(item.RoadEn))
                                            {
                                                <span class="text-xs text-tertiary font-mono block">@item.RoadEn</span>
                                            }
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-error hover:bg-red-50 hover:text-error" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (busStops != null && busStops.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@busStops.Pagination.TotalPages" TotalCount="@busStops.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Form Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavBusStops")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavBusStops")}")"
             Description="Enter bus stop details and assign township and road locations.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-red-50 border border-red-200 rounded-md text-xs text-red-700 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-on-surface mb-1">@Lang.GetText("StopNameMM") *</label>
                    <input type="text" @bind="formNameMm" class="w-full h-9 px-3 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary @(!string.IsNullOrEmpty(formNameMmError) ? "border-red-500 bg-red-50/20" : "border-outline-variant")" />
                    @if (!string.IsNullOrEmpty(formNameMmError))
                    {
                        <p class="text-2xs text-red-600 mt-1">@formNameMmError</p>
                    }
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("StopNameEN")</label>
                    <input type="text" @bind="formNameEn" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">Township</label>
                <select @bind="formTownshipId" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary bg-white">
                    <option value="">Select Township</option>
                    @if (townships != null)
                    {
                        @foreach (var t in townships)
                        {
                            <option value="@t.TownshipId">@t.TownshipNameMm (@t.TownshipNameEn)</option>
                        }
                    }
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Road (MM)</label>
                    <input type="text" @bind="formRoadMm" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Road (EN)</label>
                    <input type="text" @bind="formRoadEn" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveBusStop">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Confirmation Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-tertiary">This will remove the bus stop and unassign it from any route mappings.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<BusStopDto>? busStops;
    private List<TownshipDto>? townships;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state & validation
    private bool showFormModal = false;
    private int? editingId = null;
    private string formNameMm = "";
    private string formNameEn = "";
    private int? formTownshipId = null;
    private string formRoadMm = "";
    private string formRoadEn = "";
    private string formValidationError = "";
    private string formNameMmError = "";

    // Delete Modal state
    private bool showDeleteModal = false;
    private int? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        var loadDataTask = LoadData();
        var townshipsTask = TownshipService.GetTownshipsAsync(1, 200, null);

        await Task.WhenAll(loadDataTask, townshipsTask);

        var tRes = await townshipsTask;
        if (tRes != null && tRes.Data != null) townships = tRes.Data;
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            busStops = await BusStopService.GetBusStopsAsync(pageNumber, pageSize, searchQuery);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch() { pageNumber = 1; await LoadData(); }
    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private void OpenCreateModal()
    {
        editingId = null;
        formNameMm = "";
        formNameEn = "";
        formTownshipId = null;
        formRoadMm = "";
        formRoadEn = "";
        formValidationError = "";
        formNameMmError = "";
        showFormModal = true;
    }

    private void OpenEditModal(BusStopDto item)
    {
        editingId = item.StopId;
        formNameMm = item.NameMm;
        formNameEn = item.NameEn ?? "";
        formTownshipId = item.TownshipId;
        formRoadMm = item.RoadMm ?? "";
        formRoadEn = item.RoadEn ?? "";
        formValidationError = "";
        formNameMmError = "";
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveBusStop()
    {
        formValidationError = "";
        formNameMmError = "";

        if (string.IsNullOrWhiteSpace(formNameMm))
        {
            formNameMmError = "Stop Name (MM) is required.";
            formValidationError = "Please fix validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateBusStopRequest(formNameMm, formNameEn, formTownshipId, formRoadMm, formRoadEn);
                await BusStopService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess("Bus stop details updated successfully.");
            }
            else
            {
                var req = new CreateBusStopRequest(null, formNameMm, formNameEn, formTownshipId, formRoadMm, formRoadEn);
                await BusStopService.CreateAsync(req);
                Toast.ShowSuccess("New bus stop added successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save bus stop: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(BusStopDto item)
    {
        deletingId = item.StopId;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await BusStopService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Bus stop deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete bus stop: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
