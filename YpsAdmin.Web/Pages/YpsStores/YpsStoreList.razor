@page "/yps-stores"
@inject IYpsStoreService StoreService
@inject IBusStopService BusStopService
@inject IBusLineService BusLineService
@inject ITownshipService TownshipService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-lg border border-outline-variant shadow-2xs">
        <div>
            <h2 class="text-lg font-bold text-on-surface tracking-tight">@Lang.GetText("NavYpsStores")</h2>
            <p class="text-xs text-tertiary">Manage top-up agencies, retail partners, and customer service centers.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-tertiary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Search by township name..."
                       class="w-full h-10 pl-9 pr-3 text-sm border border-outline-variant rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Container -->
    <div class="bg-white rounded-lg border border-outline-variant shadow-2xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(stores == null || stores.Data == null || !stores.Data.Any())"
                   EmptyTitle="No YPS stores found"
                   EmptyDescription="Try adjusting your search terms or add a new YPS store location.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-surface-container/60 border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("StoreName")</th>
                                <th class="p-3.5">@Lang.GetText("Category")</th>
                                <th class="p-3.5">@Lang.GetText("TownshipMM")</th>
                                <th class="p-3.5 font-mono">@Lang.GetText("Coordinates")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">
                            @if (stores != null && stores.Data != null)
                            {
                                @foreach (var item in stores.Data)
                                {
                                    <tr class="hover:bg-surface-container/30 transition-colors">
                                        <td class="p-3.5">
                                            <div class="font-bold text-on-surface">@item.NameMm</div>
                                            @if (!string.IsNullOrEmpty(item.NameEn))
                                            {
                                                <div class="text-xs text-tertiary font-mono mt-0.5">@item.NameEn</div>
                                            }
                                        </td>
                                        <td class="p-3.5">
                                            <CategoryBadge Text="@item.Category" Variant="@CategoryBadge.ResolveStoreCategoryVariant(item.Category)" ShowDot="true" />
                                        </td>
                                        <td class="p-3.5 text-on-surface">@item.TownshipNameMm</td>
                                        <td class="p-3.5 font-mono text-xs text-secondary">
                                            @(item.Latitude?.ToString("F6") ?? "-"), @(item.Longitude?.ToString("F6") ?? "-")
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenAssignStopsModal(item)">
                                                    @Lang.GetText("AssignStops")
                                                </Button>
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenAssignBusesModal(item)">
                                                    @Lang.GetText("AssignBuses")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-error hover:bg-red-50 hover:text-error" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (stores != null && stores.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@stores.Pagination.TotalPages" TotalCount="@stores.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavYpsStores")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavYpsStores")}")"
             Description="Fill in the store name and coordinates below. Fields marked with * are required.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-red-50 border border-red-200 rounded-md text-xs text-red-700 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-on-surface mb-1">Name (MM) *</label>
                    <input type="text" @bind="formNameMm" class="w-full h-9 px-3 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary @(!string.IsNullOrEmpty(formNameMmError) ? "border-red-500 bg-red-50/20" : "border-outline-variant")" />
                    @if (!string.IsNullOrEmpty(formNameMmError))
                    {
                        <p class="text-2xs text-red-600 mt-1">@formNameMmError</p>
                    }
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Name (EN)</label>
                    <input type="text" @bind="formNameEn" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("Category")</label>
                <input type="text" @bind="formCategory" placeholder="e.g. Top-Up Point, Retail Store" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary" />
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">Township</label>
                <select @bind="formTownshipId" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary bg-white">
                    <option value="">Select Township</option>
                    @if (townships != null)
                    {
                        @foreach (var t in townships)
                        {
                            <option value="@t.TownshipId">@t.TownshipNameMm (@t.TownshipNameEn)</option>
                        }
                    }
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Latitude</label>
                    <input type="number" step="any" @bind="formLatitude" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Longitude</label>
                    <input type="number" step="any" @bind="formLongitude" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveStore">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Nearest Bus Stops Modal -->
<ModalDialog IsOpen="@showStopsModal"
             IsOpenChanged="v => showStopsModal = v"
             Title="@($"{Lang.GetText("AssignStops")} - {activeStore?.NameMm}")"
             Description="Select nearest bus stops that serve this YPS store location.">
    <ChildContent>
        <div class="max-h-64 overflow-y-auto space-y-1.5 border border-outline-variant p-3 rounded-md bg-surface-container/30">
            @if (allBusStops == null || !allBusStops.Any())
            {
                <p class="text-xs text-tertiary text-center p-4">No bus stops available.</p>
            }
            else
            {
                @foreach (var stop in allBusStops)
                {
                    <div class="flex items-center gap-2.5 p-2 hover:bg-white rounded-md text-xs transition-colors border border-transparent hover:border-outline-variant">
                        <input type="checkbox" id="@($"store_stop_{stop.StopId}")" checked="@selectedStopIds.Contains(stop.StopId)" @onchange='(e) => ToggleStopSelection(stop.StopId, e.Value)' class="h-4 w-4 rounded border-outline text-secondary focus:ring-secondary/50" />
                        <label for="@($"store_stop_{stop.StopId}")" class="flex-1 cursor-pointer select-none">
                            <span class="font-bold text-on-surface">@stop.NameMm</span>
                            <span class="text-tertiary font-mono ml-1.5">(@stop.RoadMm)</span>
                        </label>
                    </div>
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showStopsModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveNearestStops">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Serving Bus Lines Modal -->
<ModalDialog IsOpen="@showBusesModal"
             IsOpenChanged="v => showBusesModal = v"
             Title="@($"{Lang.GetText("AssignBuses")} - {activeStore?.NameMm}")"
             Description="Select bus lines serving commuters near this YPS store.">
    <ChildContent>
        <div class="max-h-64 overflow-y-auto space-y-1.5 border border-outline-variant p-3 rounded-md bg-surface-container/30">
            @if (allBusLines == null || !allBusLines.Any())
            {
                <p class="text-xs text-tertiary text-center p-4">No bus lines available.</p>
            }
            else
            {
                @foreach (var line in allBusLines)
                {
                    <div class="flex items-center gap-2.5 p-2 hover:bg-white rounded-md text-xs transition-colors border border-transparent hover:border-outline-variant">
                        <input type="checkbox" id="@($"store_bus_{line.BusNumber}")" checked="@selectedBusNumbers.Contains(line.BusNumber)" @onchange='(e) => ToggleBusLineSelection(line.BusNumber, e.Value)' class="h-4 w-4 rounded border-outline text-secondary focus:ring-secondary/50" />
                        <label for="@($"store_bus_{line.BusNumber}")" class="flex-1 cursor-pointer select-none">
                            <span class="font-bold text-secondary">Bus @line.BusNumber</span>
                            @if (!string.IsNullOrEmpty(line.OutboundTitleMm))
                            {
                                <span class="text-tertiary ml-1.5">(@line.OutboundTitleMm)</span>
                            }
                        </label>
                    </div>
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showBusesModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveServingBuses">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-tertiary">This action cannot be undone. Removing this store will un-assign its nearest bus stops and serving lines.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<YpsStoreDto>? stores;
    private List<TownshipDto>? townships;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state & validation
    private bool showFormModal = false;
    private int? editingId = null;
    private string formNameMm = "";
    private string formNameEn = "";
    private string formCategory = "";
    private int? formTownshipId = null;
    private decimal formLatitude = 16.8661m;
    private decimal formLongitude = 96.1951m;
    private string formValidationError = "";
    private string formNameMmError = "";

    // Nearest Stops Modal
    private bool showStopsModal = false;
    private YpsStoreDto? activeStore;
    private List<BusStopDto>? allBusStops;
    private HashSet<int> selectedStopIds = new();

    // Serving Buses Modal
    private bool showBusesModal = false;
    private List<BusLineDto>? allBusLines;

    // Delete Modal
    private bool showDeleteModal = false;
    private int? deletingId = null;

    private CancellationTokenSource? searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task EnsureTownshipsLoadedAsync()
    {
        if (townships == null)
        {
            var res = await TownshipService.GetTownshipsAsync(1, 500, null);
            if (res != null && res.Data != null) townships = res.Data;
        }
    }

    private async Task EnsureBusStopsLoadedAsync()
    {
        if (allBusStops == null)
        {
            var res = await BusStopService.GetBusStopsAsync(1, 500, null);
            if (res != null && res.Data != null) allBusStops = res.Data;
        }
    }

    private async Task EnsureBusLinesLoadedAsync()
    {
        if (allBusLines == null)
        {
            var res = await BusLineService.GetBusLinesAsync(1, 200, null);
            if (res != null && res.Data != null) allBusLines = res.Data;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            stores = await StoreService.GetStoresAsync(pageNumber, pageSize, searchQuery);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            pageNumber = 1;
            await LoadData();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private async Task OpenCreateModal()
    {
        editingId = null;
        formNameMm = "";
        formNameEn = "";
        formCategory = "";
        formTownshipId = null;
        formLatitude = 16.8661m;
        formLongitude = 96.1951m;
        formValidationError = "";
        formNameMmError = "";
        await EnsureTownshipsLoadedAsync();
        showFormModal = true;
    }

    private async Task OpenEditModal(YpsStoreDto item)
    {
        editingId = item.StoreId;
        formNameMm = item.NameMm;
        formNameEn = item.NameEn ?? "";
        formCategory = item.Category ?? "";
        formTownshipId = item.TownshipId;
        formLatitude = item.Latitude ?? 16.8661m;
        formLongitude = item.Longitude ?? 96.1951m;
        formValidationError = "";
        formNameMmError = "";
        await EnsureTownshipsLoadedAsync();
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveStore()
    {
        formValidationError = "";
        formNameMmError = "";

        if (string.IsNullOrWhiteSpace(formNameMm))
        {
            formNameMmError = "Store Name (MM) is required.";
            formValidationError = "Please fix the validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateYpsStoreRequest(formNameMm, formNameEn, formCategory, formTownshipId, formLatitude, formLongitude);
                await StoreService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess("Store details updated successfully.");
            }
            else
            {
                var req = new CreateYpsStoreRequest(null, formNameMm, formNameEn, formCategory, formTownshipId, formLatitude, formLongitude);
                await StoreService.CreateAsync(req);
                Toast.ShowSuccess("New YPS store added successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save store: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenAssignStopsModal(YpsStoreDto item)
    {
        activeStore = item;
        selectedStopIds.Clear();
        if (item.NearestStops != null)
        {
            foreach (var ns in item.NearestStops)
            {
                if (ns.MatchedStopId.HasValue) selectedStopIds.Add(ns.MatchedStopId.Value);
            }
        }
        await EnsureBusStopsLoadedAsync();
        showStopsModal = true;
    }

    private void ToggleStopSelection(int busStopId, object? isChecked)
    {
        if (isChecked is bool b && b) selectedStopIds.Add(busStopId);
        else selectedStopIds.Remove(busStopId);
    }

    private async Task SaveNearestStops()
    {
        if (activeStore == null) return;
        isSaving = true;
        try
        {
            var items = selectedStopIds.Select(sId => {
                var s = allBusStops?.FirstOrDefault(x => x.StopId == sId);
                return new AssignNearestStopItem(sId, s?.NameMm, s?.NameEn);
            }).ToList();
            var req = new AssignNearestStopsRequest(items);
            await StoreService.AssignNearestStopsAsync(activeStore.StoreId, req);
            Toast.ShowSuccess("Assigned nearest bus stops updated.");
            showStopsModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to assign stops: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private HashSet<string> selectedBusNumbers = new();

    private async Task OpenAssignBusesModal(YpsStoreDto item)
    {
        activeStore = item;
        selectedBusNumbers.Clear();
        if (item.ServingBusLines != null)
        {
            foreach (var b in item.ServingBusLines)
            {
                selectedBusNumbers.Add(b);
            }
        }
        await EnsureBusLinesLoadedAsync();
        showBusesModal = true;
    }

    private void ToggleBusLineSelection(string busNumber, object? isChecked)
    {
        if (isChecked is bool b && b) selectedBusNumbers.Add(busNumber);
        else selectedBusNumbers.Remove(busNumber);
    }

    private async Task SaveServingBuses()
    {
        if (activeStore == null) return;
        isSaving = true;
        try
        {
            var req = new AssignServingBusLinesRequest(selectedBusNumbers.ToList());
            await StoreService.AssignServingBusLinesAsync(activeStore.StoreId, req);
            Toast.ShowSuccess("Assigned serving bus lines updated.");
            showBusesModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to assign bus lines: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(YpsStoreDto item)
    {
        deletingId = item.StoreId;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await StoreService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Store deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete store: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
