@page "/yps-stores"
@inject IYpsStoreService StoreService
@inject IBusStopService BusStopService
@inject IBusLineService BusLineService
@inject ITownshipService TownshipService
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-md border border-outline-variant">
        <div>
            <h2 class="text-lg font-bold text-on-surface">@Lang.GetText("NavYpsStores")</h2>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="flex items-center gap-2 flex-1 sm:w-64">
                <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="@Lang.GetText("Search")..." class="w-full h-10 px-3 py-2 text-sm border border-outline rounded-md focus:outline-none focus:border-secondary" />
            </div>
            <button type="button" @onclick="OpenCreateModal" class="h-10 px-4 bg-secondary text-white text-sm font-semibold rounded-md hover:bg-secondary/90 transition-colors whitespace-nowrap">
                + @Lang.GetText("Add")
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-md border border-outline-variant overflow-hidden">
        @if (isLoading)
        {
            <div class="p-8 text-center text-sm text-tertiary">Loading...</div>
        }
        else if (stores == null || stores.Data == null || !stores.Data.Any())
        {
            <div class="p-8 text-center text-sm text-tertiary">No YPS stores found.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-surface-container border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                            <th class="p-3">@Lang.GetText("StoreName")</th>
                            <th class="p-3">@Lang.GetText("Category")</th>
                            <th class="p-3">@Lang.GetText("TownshipMM")</th>
                            <th class="p-3 font-mono">@Lang.GetText("Coordinates")</th>
                            <th class="p-3 text-right">@Lang.GetText("Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        @foreach (var item in stores.Data)
                        {
                            <tr class="hover:bg-surface transition-colors">
                                <td class="p-3">
                                    <div class="font-bold text-on-surface">@item.NameMm</div>
                                    @if (!string.IsNullOrEmpty(item.NameEn))
                                    {
                                        <div class="text-xs text-tertiary font-mono">@item.NameEn</div>
                                    }
                                </td>
                                <td class="p-3">
                                    <span class="inline-block px-2.5 py-0.5 text-xs font-semibold bg-surface-container-high text-on-surface rounded border border-outline-variant">@item.Category</span>
                                </td>
                                <td class="p-3 text-on-surface">@item.TownshipNameMm</td>
                                <td class="p-3 font-mono text-xs text-secondary">
                                    @(item.Latitude?.ToString("F6") ?? "-"), @(item.Longitude?.ToString("F6") ?? "-")
                                </td>
                                <td class="p-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button type="button" @onclick="() => OpenAssignStopsModal(item)" class="px-2 py-1 text-xs font-medium text-secondary border border-secondary/30 rounded hover:bg-secondary/10">
                                            @Lang.GetText("AssignStops")
                                        </button>
                                        <button type="button" @onclick="() => OpenAssignBusesModal(item)" class="px-2 py-1 text-xs font-medium text-secondary border border-secondary/30 rounded hover:bg-secondary/10">
                                            @Lang.GetText("AssignBuses")
                                        </button>
                                        <button type="button" @onclick="() => OpenEditModal(item)" class="px-2 py-1 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                                            @Lang.GetText("Edit")
                                        </button>
                                        <button type="button" @onclick="() => PromptDelete(item)" class="px-2 py-1 text-xs font-medium text-red-700 border border-red-200 rounded hover:bg-red-50">
                                            @Lang.GetText("Delete")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-3 border-t border-outline-variant bg-surface-container flex items-center justify-between">
                <span class="text-xs text-tertiary">Page @pageNumber of @stores.Pagination.TotalPages (@stores.Pagination.TotalCount items)</span>
                <div class="flex items-center gap-2">
                    <button type="button" disabled="@(!stores.Pagination.HasPreviousPage)" @onclick="PreviousPage" class="px-3 py-1 text-xs font-medium bg-white border border-outline rounded disabled:opacity-40 hover:bg-surface-container-high">
                        @Lang.GetText("Previous")
                    </button>
                    <button type="button" disabled="@(!stores.Pagination.HasNextPage)" @onclick="NextPage" class="px-3 py-1 text-xs font-medium bg-white border border-outline rounded disabled:opacity-40 hover:bg-surface-container-high">
                        @Lang.GetText("Next")
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create / Edit Modal -->
@if (showFormModal)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-md w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-on-surface border-b border-outline-variant pb-2">
                @(editingId.HasValue ? Lang.GetText("Edit") : Lang.GetText("Add")) @Lang.GetText("NavYpsStores")
            </h3>

            <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">Name (MM)</label>
                        <input type="text" @bind="formNameMm" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">Name (EN)</label>
                        <input type="text" @bind="formNameEn" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("Category")</label>
                    <input type="text" @bind="formCategory" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Township</label>
                    <select @bind="formTownshipId" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary bg-white">
                        <option value="">Select Township</option>
                        @if (townships != null)
                        {
                            @foreach (var t in townships)
                            {
                                <option value="@t.TownshipId">@t.TownshipNameMm (@t.TownshipNameEn)</option>
                            }
                        }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">Latitude</label>
                        <input type="number" step="any" @bind="formLatitude" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-tertiary mb-1">Longitude</label>
                        <input type="number" step="any" @bind="formLongitude" class="w-full h-9 px-3 text-sm border border-outline rounded focus:outline-none focus:border-secondary font-mono" />
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" @onclick="CloseFormModal" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="SaveStore" class="px-4 py-1.5 text-xs font-semibold bg-secondary text-white rounded hover:bg-secondary/90">
                    @Lang.GetText("Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Link Nearest Bus Stops Modal -->
@if (showStopsModal && activeStore != null)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-md w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-on-surface border-b border-outline-variant pb-2">
                @Lang.GetText("AssignStops") - @activeStore.NameMm
            </h3>

            <div class="max-h-64 overflow-y-auto space-y-2 border border-outline-variant p-3 rounded bg-surface">
                @if (allBusStops == null || !allBusStops.Any())
                {
                    <p class="text-xs text-tertiary">No bus stops available.</p>
                }
                else
                {
                    @foreach (var stop in allBusStops)
                    {
                        <div class="flex items-center gap-2 p-1.5 hover:bg-white rounded text-xs">
                            <input type="checkbox" id="@($"store_stop_{stop.StopId}")" checked="@selectedStopIds.Contains(stop.StopId)" @onchange='(e) => ToggleStopSelection(stop.StopId, e.Value)' class="h-4 w-4 rounded border-outline text-secondary" />
                            <label for="@($"store_stop_{stop.StopId}")" class="flex-1 cursor-pointer">
                                <span class="font-bold text-on-surface">@stop.NameMm</span>
                                <span class="text-tertiary font-mono ml-1">(@stop.RoadMm)</span>
                            </label>
                        </div>
                    }
                }
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" @onclick="() => showStopsModal = false" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="SaveNearestStops" class="px-4 py-1.5 text-xs font-semibold bg-secondary text-white rounded hover:bg-secondary/90">
                    @Lang.GetText("Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Link Serving Bus Lines Modal -->
@if (showBusesModal && activeStore != null)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-md w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-on-surface border-b border-outline-variant pb-2">
                @Lang.GetText("AssignBuses") - @activeStore.NameMm
            </h3>

            <div class="max-h-64 overflow-y-auto space-y-2 border border-outline-variant p-3 rounded bg-surface">
                @if (allBusLines == null || !allBusLines.Any())
                {
                    <p class="text-xs text-tertiary">No bus lines available.</p>
                }
                else
                {
                    @foreach (var line in allBusLines)
                    {
                        <div class="flex items-center gap-2 p-1.5 hover:bg-white rounded text-xs">
                            <input type="checkbox" id="@($"store_bus_{line.BusNumber}")" checked="@selectedBusNumbers.Contains(line.BusNumber)" @onchange='(e) => ToggleBusLineSelection(line.BusNumber, e.Value)' class="h-4 w-4 rounded border-outline text-secondary" />
                            <label for="@($"store_bus_{line.BusNumber}")" class="flex-1 cursor-pointer">
                                <span class="font-bold text-on-surface">Bus #@line.BusNumber</span>
                                @if (!string.IsNullOrEmpty(line.OutboundTitleMm))
                                {
                                    <span class="text-tertiary ml-1">(@line.OutboundTitleMm)</span>
                                }
                            </label>
                        </div>
                    }
                }
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" @onclick="() => showBusesModal = false" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="SaveServingBuses" class="px-4 py-1.5 text-xs font-semibold bg-secondary text-white rounded hover:bg-secondary/90">
                    @Lang.GetText("Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Modal -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-md border border-outline-variant shadow-lg max-w-sm w-full p-6 space-y-4">
            <h3 class="text-base font-bold text-red-700">@Lang.GetText("ConfirmDeleteTitle")</h3>
            <p class="text-xs text-tertiary">@Lang.GetText("ConfirmDeleteMessage")</p>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="() => showDeleteModal = false" class="px-4 py-1.5 text-xs font-medium border border-outline rounded hover:bg-surface-container">
                    @Lang.GetText("Cancel")
                </button>
                <button type="button" @onclick="ConfirmDelete" class="px-4 py-1.5 text-xs font-semibold bg-red-700 text-white rounded hover:bg-red-800">
                    @Lang.GetText("Confirm")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<YpsStoreDto>? stores;
    private List<TownshipDto>? townships;
    private bool isLoading = true;
    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state
    private bool showFormModal = false;
    private int? editingId = null;
    private string formNameMm = "";
    private string formNameEn = "";
    private string formCategory = "";
    private int? formTownshipId = null;
    private decimal formLatitude = 16.8661m;
    private decimal formLongitude = 96.1951m;

    // Nearest Stops Modal
    private bool showStopsModal = false;
    private YpsStoreDto? activeStore;
    private List<BusStopDto>? allBusStops;
    private HashSet<int> selectedStopIds = new();

    // Serving Buses Modal
    private bool showBusesModal = false;
    private List<BusLineDto>? allBusLines;
    private HashSet<int> selectedBusNumbers = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private int? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        var tRes = await TownshipService.GetTownshipsAsync(1, 200, null);
        if (tRes != null && tRes.Data != null) townships = tRes.Data;

        var stopsRes = await BusStopService.GetBusStopsAsync(1, 500, null);
        if (stopsRes != null && stopsRes.Data != null) allBusStops = stopsRes.Data;

        var busesRes = await BusLineService.GetBusLinesAsync(1, 200, null);
        if (busesRes != null && busesRes.Data != null) allBusLines = busesRes.Data;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            stores = await StoreService.GetStoresAsync(pageNumber, pageSize, searchQuery);
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task HandleSearch() { pageNumber = 1; await LoadData(); }
    private async Task PreviousPage() { if (pageNumber > 1) { pageNumber--; await LoadData(); } }
    private async Task NextPage() { if (stores != null && stores.Pagination.HasNextPage) { pageNumber++; await LoadData(); } }

    private void OpenCreateModal()
    {
        editingId = null;
        formNameMm = "";
        formNameEn = "";
        formCategory = "";
        formTownshipId = null;
        formLatitude = 16.8661m;
        formLongitude = 96.1951m;
        showFormModal = true;
    }

    private void OpenEditModal(YpsStoreDto item)
    {
        editingId = item.StoreId;
        formNameMm = item.NameMm;
        formNameEn = item.NameEn ?? "";
        formCategory = item.Category ?? "";
        formTownshipId = item.TownshipId;
        formLatitude = item.Latitude ?? 16.8661m;
        formLongitude = item.Longitude ?? 96.1951m;
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveStore()
    {
        if (editingId.HasValue)
        {
            var req = new UpdateYpsStoreRequest(formNameMm, formNameEn, formCategory, formTownshipId, formLatitude, formLongitude);
            await StoreService.UpdateAsync(editingId.Value, req);
        }
        else
        {
            var req = new CreateYpsStoreRequest(null, formNameMm, formNameEn, formCategory, formTownshipId, formLatitude, formLongitude);
            await StoreService.CreateAsync(req);
        }
        showFormModal = false;
        await LoadData();
    }

    private void OpenAssignStopsModal(YpsStoreDto item)
    {
        activeStore = item;
        selectedStopIds.Clear();
        if (item.NearestStops != null)
        {
            foreach (var ns in item.NearestStops)
            {
                if (ns.MatchedStopId.HasValue) selectedStopIds.Add(ns.MatchedStopId.Value);
            }
        }
        showStopsModal = true;
    }

    private void ToggleStopSelection(int busStopId, object? isChecked)
    {
        if (isChecked is bool b && b) selectedStopIds.Add(busStopId);
        else selectedStopIds.Remove(busStopId);
    }

    private async Task SaveNearestStops()
    {
        if (activeStore != null)
        {
            var items = selectedStopIds.Select(sId => {
                var s = allBusStops?.FirstOrDefault(x => x.StopId == sId);
                return new AssignNearestStopItem(sId, s?.NameMm, s?.NameEn);
            }).ToList();
            var req = new AssignNearestStopsRequest(items);
            await StoreService.AssignNearestStopsAsync(activeStore.StoreId, req);
        }
        showStopsModal = false;
        await LoadData();
    }

    private void OpenAssignBusesModal(YpsStoreDto item)
    {
        activeStore = item;
        selectedBusNumbers.Clear();
        if (item.ServingBusLines != null)
        {
            foreach (var b in item.ServingBusLines)
            {
                selectedBusNumbers.Add(b);
            }
        }
        showBusesModal = true;
    }

    private void ToggleBusLineSelection(int busNumber, object? isChecked)
    {
        if (isChecked is bool b && b) selectedBusNumbers.Add(busNumber);
        else selectedBusNumbers.Remove(busNumber);
    }

    private async Task SaveServingBuses()
    {
        if (activeStore != null)
        {
            var req = new AssignServingBusLinesRequest(selectedBusNumbers.ToList());
            await StoreService.AssignServingBusLinesAsync(activeStore.StoreId, req);
        }
        showBusesModal = false;
        await LoadData();
    }

    private void PromptDelete(YpsStoreDto item)
    {
        deletingId = item.StoreId;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (deletingId.HasValue)
        {
            await StoreService.DeleteAsync(deletingId.Value);
            showDeleteModal = false;
            await LoadData();
        }
    }
}
