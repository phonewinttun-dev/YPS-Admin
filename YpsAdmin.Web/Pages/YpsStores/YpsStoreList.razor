@page "/yps-stores"
@inject IStoreService StoreService
@inject IBusStopService BusStopService
@inject IRegionService RegionService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-lg border border-outline-variant shadow-2xs">
        <div>
            <h2 class="text-lg font-bold text-on-surface tracking-tight">@Lang.GetText("NavYpsStores")</h2>
            <p class="text-xs text-tertiary">Manage top-up agencies, retail partners, and customer service centers.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-tertiary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Search stores..."
                       class="w-full h-10 pl-9 pr-3 text-sm border border-outline-variant rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Container -->
    <div class="bg-white rounded-lg border border-outline-variant shadow-2xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(stores == null || stores.Data == null || !stores.Data.Any())"
                   EmptyTitle="No YPS stores found"
                   EmptyDescription="Try adjusting your search terms or add a new YPS store location.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-surface-container/60 border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("StoreName")</th>
                                <th class="p-3.5">@Lang.GetText("Category")</th>
                                <th class="p-3.5">@Lang.GetText("Region")</th>
                                <th class="p-3.5 font-mono">@Lang.GetText("Coordinates")</th>
                                <th class="p-3.5">@Lang.GetText("ServingBuses")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">
                            @if (stores != null && stores.Data != null)
                            {
                                @foreach (var item in stores.Data)
                                {
                                    <tr class="hover:bg-surface-container/30 transition-colors">
                                        <td class="p-3.5">
                                            <div class="font-bold text-on-surface">@(item.MmName ?? item.EngName ?? "Unnamed Store")</div>
                                            @if (!string.IsNullOrEmpty(item.EngName) && item.EngName != item.MmName)
                                            {
                                                <div class="text-xs text-tertiary font-mono mt-0.5">@item.EngName</div>
                                            }
                                        </td>
                                        <td class="p-3.5">
                                            <CategoryBadge Text="@item.Category" Variant="@CategoryBadge.ResolveStoreCategoryVariant(item.Category)" ShowDot="true" />
                                        </td>
                                        <td class="p-3.5 text-on-surface">@(item.RegionName ?? "Unassigned")</td>
                                        <td class="p-3.5 font-mono text-xs text-secondary">
                                            @item.Lat.ToString("F6"), @item.Lon.ToString("F6")
                                        </td>
                                        <td class="p-3.5">
                                            @if (item.ServingBusNumbers != null && item.ServingBusNumbers.Any())
                                            {
                                                <div class="flex flex-wrap gap-1">
                                                    @foreach (var bNum in item.ServingBusNumbers.Take(4))
                                                    {
                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-2xs font-mono font-bold bg-secondary/10 text-secondary border border-secondary/20">
                                                            Bus @bNum
                                                        </span>
                                                    }
                                                    @if (item.ServingBusNumbers.Count > 4)
                                                    {
                                                        <span class="text-2xs text-tertiary font-mono self-center">
                                                            +@(item.ServingBusNumbers.Count - 4) more
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-tertiary">-</span>
                                            }
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenAssignStopsModal(item)">
                                                    @Lang.GetText("AssignStops")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-error hover:bg-red-50 hover:text-error" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (stores != null && stores.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@stores.Pagination.TotalPages" TotalCount="@stores.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavYpsStores")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavYpsStores")}")"
             Description="Fill in the store name and coordinates below.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-red-50 border border-red-200 rounded-md text-xs text-red-700 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3">
            <div>
                <label class="block text-xs font-medium text-on-surface mb-1">Name (MM) *</label>
                <input type="text" @bind="formMmName" class="w-full h-9 px-3 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary @(!string.IsNullOrEmpty(formMmNameError) ? "border-red-500 bg-red-50/20" : "border-outline-variant")" />
                @if (!string.IsNullOrEmpty(formMmNameError))
                {
                    <p class="text-2xs text-red-600 mt-1">@formMmNameError</p>
                }
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">Name (EN)</label>
                <input type="text" @bind="formEngName" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("Category")</label>
                <input type="text" @bind="formCategory" placeholder="e.g. Top-Up Point, Retail Store" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary" />
            </div>
            <div>
                <AccessibleSelect TValue="int?"
                                  Label="@Lang.GetText("Region")"
                                  @bind-Value="formRegionId"
                                  Items="@regionSelectItems"
                                  Placeholder="Select Region"
                                  AllowClear="true" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Latitude</label>
                    <input type="number" step="any" @bind="formLat" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-tertiary mb-1">Longitude</label>
                    <input type="number" step="any" @bind="formLon" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveStore">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Nearest Bus Stops Modal -->
<ModalDialog IsOpen="@showStopsModal"
             IsOpenChanged="v => showStopsModal = v"
             Title="@($"{Lang.GetText("AssignStops")} - {activeStore?.MmName ?? activeStore?.EngName}")"
             Description="Select nearest bus stops that serve this YPS store location.">
    <ChildContent>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-3">
            <div class="flex-1">
                <AccessibleSelect TValue="int?"
                                  Value="@stopsModalRegionId"
                                  ValueChanged="OnStopsModalRegionChanged"
                                  Items="@regionSelectItems"
                                  Placeholder="All Regions"
                                  AllowClear="true"
                                  AriaLabel="Filter nearest stops by Region" />
            </div>
            <label class="inline-flex items-center gap-2 text-xs font-medium text-on-surface cursor-pointer select-none border border-outline-variant px-3 py-1.5 rounded-md hover:bg-surface-container/50 transition-colors h-[38px]">
                <input type="checkbox" @bind="showOnlyLinkedStops" class="h-4 w-4 rounded border-outline text-secondary focus:ring-secondary/50" />
                <span>Linked Stops</span>
            </label>
        </div>
        <div class="max-h-64 overflow-y-auto space-y-1.5 border border-outline-variant p-3 rounded-md bg-surface-container/30">
            @{
                var displayedStops = showOnlyLinkedStops
                    ? allBusStops?.Where(s => selectedStopMap.ContainsKey(s.Id)).ToList()
                    : allBusStops;
            }
            @if (displayedStops == null || !displayedStops.Any())
            {
                <p class="text-xs text-tertiary text-center p-4">
                    @(showOnlyLinkedStops ? "No linked bus stops found." : "No bus stops available.")
                </p>
            }
            else
            {
                @foreach (var stop in displayedStops)
                {
                    var isChecked = selectedStopMap.ContainsKey(stop.Id);
                    <div class="flex items-center justify-between gap-2.5 p-2 hover:bg-white rounded-md text-xs transition-colors border border-transparent hover:border-outline-variant">
                        <div class="flex items-center gap-2.5 flex-1">
                            <input type="checkbox" id="@($"store_stop_{stop.Id}")" checked="@isChecked" @onchange='(e) => ToggleStopSelection(stop.Id, e.Value)' class="h-4 w-4 rounded border-outline text-secondary focus:ring-secondary/50" />
                            <label for="@($"store_stop_{stop.Id}")" class="cursor-pointer select-none">
                                <span class="font-bold text-on-surface">@stop.StopName</span>
                                <span class="text-tertiary font-mono ml-1.5">(@(stop.RegionName ?? "No Region"))</span>
                            </label>
                        </div>
                        @if (isChecked)
                        {
                            <div class="flex items-center gap-1">
                                <span class="text-2xs text-tertiary font-mono">km:</span>
                                <input type="number" step="0.01" min="0" 
                                       value="@(selectedStopMap.TryGetValue(stop.Id, out var dist) ? dist : 0.1)"
                                       @onchange='(e) => UpdateDistance(stop.Id, e.Value)'
                                       class="w-16 h-7 px-1.5 text-xs border border-outline-variant rounded font-mono" />
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showStopsModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveNearestStops">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-tertiary">This action cannot be undone. Removing this store will un-assign its nearest bus stops.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<StoreDto>? stores;
    private List<RegionDto>? regions;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state & validation
    private bool showFormModal = false;
    private int? editingId = null;
    private string formMmName = "";
    private string formEngName = "";
    private string formCategory = "";
    private int? formRegionId = null;
    private double formLat = 16.8661;
    private double formLon = 96.1951;
    private string formValidationError = "";
    private string formMmNameError = "";

    // Nearest Stops Modal
    private bool showStopsModal = false;
    private bool showOnlyLinkedStops = false;
    private int? stopsModalRegionId = null;
    private StoreDto? activeStore;
    private List<BusStopDto>? allBusStops;
    private Dictionary<long, double> selectedStopMap = new();

    private IEnumerable<SelectItem<int?>>? regionSelectItems => regions?.Select(r => new SelectItem<int?>(r.Id, r.RegionName));

    // Delete Modal
    private bool showDeleteModal = false;
    private int? deletingId = null;

    private CancellationTokenSource? searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task EnsureRegionsLoadedAsync()
    {
        if (regions == null)
        {
            var res = await RegionService.GetRegionsAsync(1, 500, null);
            if (res != null && res.Data != null) regions = res.Data;
        }
    }

    private async Task EnsureBusStopsLoadedAsync()
    {
        if (allBusStops == null)
        {
            var res = await BusStopService.GetBusStopsAsync(1, 500, null);
            if (res != null && res.Data != null) allBusStops = res.Data;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            stores = await StoreService.GetStoresAsync(pageNumber, pageSize, searchQuery);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            pageNumber = 1;
            await LoadData();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private async Task OpenCreateModal()
    {
        editingId = null;
        formMmName = "";
        formEngName = "";
        formCategory = "";
        formRegionId = null;
        formLat = 16.8661;
        formLon = 96.1951;
        formValidationError = "";
        formMmNameError = "";
        await EnsureRegionsLoadedAsync();
        showFormModal = true;
    }

    private async Task OpenEditModal(StoreDto item)
    {
        editingId = item.Id;
        formMmName = item.MmName ?? "";
        formEngName = item.EngName ?? "";
        formCategory = item.Category ?? "";
        formRegionId = item.RegionId;
        formLat = item.Lat;
        formLon = item.Lon;
        formValidationError = "";
        formMmNameError = "";
        await EnsureRegionsLoadedAsync();
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveStore()
    {
        formValidationError = "";
        formMmNameError = "";

        if (string.IsNullOrWhiteSpace(formMmName) && string.IsNullOrWhiteSpace(formEngName))
        {
            formMmNameError = "Store Name is required.";
            formValidationError = "Please fix the validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateStoreRequest(
                    string.IsNullOrWhiteSpace(formEngName) ? null : formEngName.Trim(),
                    string.IsNullOrWhiteSpace(formMmName) ? null : formMmName.Trim(),
                    string.IsNullOrWhiteSpace(formCategory) ? null : formCategory.Trim(),
                    formLat, formLon, formRegionId, false);
                await StoreService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess("Store details updated successfully.");
            }
            else
            {
                var req = new CreateStoreRequest(
                    string.IsNullOrWhiteSpace(formEngName) ? null : formEngName.Trim(),
                    string.IsNullOrWhiteSpace(formMmName) ? null : formMmName.Trim(),
                    string.IsNullOrWhiteSpace(formCategory) ? null : formCategory.Trim(),
                    formLat, formLon, formRegionId);
                await StoreService.CreateAsync(req);
                Toast.ShowSuccess("New YPS store added successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save store: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenAssignStopsModal(StoreDto item)
    {
        activeStore = item;
        showOnlyLinkedStops = false;
        stopsModalRegionId = item.RegionId;
        selectedStopMap.Clear();
        if (item.NearestStops != null)
        {
            foreach (var ns in item.NearestStops)
            {
                selectedStopMap[ns.BusStopId] = ns.DistanceKm ?? 0.1;
            }
        }
        await EnsureRegionsLoadedAsync();
        if (stopsModalRegionId.HasValue)
        {
            var res = await BusStopService.GetBusStopByRegionAsync(stopsModalRegionId.Value);
            if (res != null && res.IsSuccess && res.Data != null)
            {
                allBusStops = res.Data;
            }
            else
            {
                await EnsureBusStopsLoadedAsync();
            }
        }
        else
        {
            await EnsureBusStopsLoadedAsync();
        }
        showStopsModal = true;
    }

    private async Task OnStopsModalRegionChanged(int? newRegionId)
    {
        stopsModalRegionId = newRegionId;
        if (stopsModalRegionId.HasValue)
        {
            var res = await BusStopService.GetBusStopByRegionAsync(stopsModalRegionId.Value);
            if (res != null && res.IsSuccess && res.Data != null)
            {
                allBusStops = res.Data;
            }
        }
        else
        {
            var res = await BusStopService.GetBusStopsAsync(1, 500, null);
            if (res != null && res.Data != null)
            {
                allBusStops = res.Data;
            }
        }
    }

    private void ToggleStopSelection(long busStopId, object? isChecked)
    {
        if (isChecked is bool b && b)
        {
            if (!selectedStopMap.ContainsKey(busStopId)) selectedStopMap[busStopId] = 0.1;
        }
        else
        {
            selectedStopMap.Remove(busStopId);
        }
    }

    private void UpdateDistance(long busStopId, object? val)
    {
        if (double.TryParse(val?.ToString(), out double d))
        {
            selectedStopMap[busStopId] = d;
        }
    }

    private async Task SaveNearestStops()
    {
        if (activeStore == null) return;
        isSaving = true;
        try
        {
            var items = selectedStopMap.Select(kvp => new AssignNearestBusStopItem(kvp.Key, kvp.Value)).ToList();
            var req = new AssignNearestStopsRequest(items);
            await StoreService.AssignNearestStopsAsync(activeStore.Id, req);
            Toast.ShowSuccess("Assigned nearest bus stops updated.");
            showStopsModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to assign stops: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(StoreDto item)
    {
        deletingId = item.Id;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await StoreService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Store deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete store: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
