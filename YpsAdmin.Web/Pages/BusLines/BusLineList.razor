@page "/bus-lines"
@inject IBusLineService BusLineService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-lg border border-outline-variant shadow-2xs">
        <div>
            <h2 class="text-lg font-bold text-on-surface tracking-tight">@Lang.GetText("NavBusLines")</h2>
            <p class="text-xs text-tertiary">Manage YBS transit lines, routes, titles, and YPS card acceptance status.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-tertiary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleSearch"
                       placeholder="Search by bus number..."
                       class="w-full h-10 pl-9 pr-3 text-sm border border-outline-variant rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Wrapper -->
    <div class="bg-white rounded-lg border border-outline-variant shadow-2xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(busLines == null || busLines.Data == null || !busLines.Data.Any())"
                   EmptyTitle="No bus lines found"
                   EmptyDescription="Try searching for a different bus number or create a new bus line entry.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-surface-container/60 border-b border-outline-variant text-xs font-semibold text-tertiary uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("BusNumber")</th>
                                <th class="p-3.5">@Lang.GetText("OutboundTitle")</th>
                                <th class="p-3.5">@Lang.GetText("ReturnTitle")</th>
                                <th class="p-3.5 text-center">@Lang.GetText("YpsAccepted")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">
                            @if (busLines != null && busLines.Data != null)
                            {
                                @foreach (var item in busLines.Data)
                                {
                                    <tr class="hover:bg-surface-container/30 transition-colors">
                                        <td class="p-3.5 font-bold font-mono text-secondary text-base">
                                            @item.BusNumber
                                        </td>
                                        <td class="p-3.5 text-on-surface max-w-xs truncate">
                                            @item.OutboundTitleMm
                                            @if (!string.IsNullOrEmpty(item.OutboundTitleEn))
                                            {
                                                <span class="text-xs text-tertiary font-mono block">@item.OutboundTitleEn</span>
                                            }
                                        </td>
                                        <td class="p-3.5 text-on-surface max-w-xs truncate">
                                            @item.ReturnTitleMm
                                            @if (!string.IsNullOrEmpty(item.ReturnTitleEn))
                                            {
                                                <span class="text-xs text-tertiary font-mono block">@item.ReturnTitleEn</span>
                                            }
                                        </td>
                                        <td class="p-3.5 text-center">
                                            @if (item.IsYpsAccepted)
                                            {
                                                <CategoryBadge Text="@Lang.GetText("Yes")" Variant="CategoryBadge.BadgeVariant.YpsAccepted" ShowDot="true" />
                                            }
                                            else
                                            {
                                                <CategoryBadge Text="@Lang.GetText("No")" Variant="CategoryBadge.BadgeVariant.Outline" ShowDot="false" />
                                            }
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-error hover:bg-red-50 hover:text-error" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (busLines != null && busLines.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@busLines.Pagination.TotalPages" TotalCount="@busLines.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Form Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavBusLines")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavBusLines")}")"
             Description="Enter bus line number and outbound/return route titles.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-red-50 border border-red-200 rounded-md text-xs text-red-700 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3">
            <div>
                <label class="block text-xs font-medium text-on-surface mb-1">@Lang.GetText("BusNumber") *</label>
                <input type="number" @bind="formBusNumber" min="1" class="w-full h-9 px-3 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono @(!string.IsNullOrEmpty(formBusNumberError) ? "border-red-500 bg-red-50/20" : "border-outline-variant")" />
                @if (!string.IsNullOrEmpty(formBusNumberError))
                {
                    <p class="text-2xs text-red-600 mt-1">@formBusNumberError</p>
                }
            </div>
            <div>
                <label class="block text-xs font-medium text-on-surface mb-1">@Lang.GetText("OutboundTitle") (MM) *</label>
                <input type="text" @bind="formOutboundTitleMm" class="w-full h-9 px-3 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary @(!string.IsNullOrEmpty(formOutboundError) ? "border-red-500 bg-red-50/20" : "border-outline-variant")" />
                @if (!string.IsNullOrEmpty(formOutboundError))
                {
                    <p class="text-2xs text-red-600 mt-1">@formOutboundError</p>
                }
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("OutboundTitle") (EN)</label>
                <input type="text" @bind="formOutboundTitleEn" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("ReturnTitle") (MM)</label>
                <input type="text" @bind="formReturnTitleMm" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary" />
            </div>
            <div>
                <label class="block text-xs font-medium text-tertiary mb-1">@Lang.GetText("ReturnTitle") (EN)</label>
                <input type="text" @bind="formReturnTitleEn" class="w-full h-9 px-3 text-sm border border-outline-variant rounded-md focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary font-mono" />
            </div>
            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="ypsCheck" @bind="formYpsAccepted" class="h-4 w-4 rounded border-outline text-secondary focus:ring-secondary/50" />
                <label for="ypsCheck" class="text-sm font-medium text-on-surface cursor-pointer select-none">@Lang.GetText("YpsAccepted")</label>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveBusLine">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Confirmation Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-tertiary">Deleting this bus line will also remove any mapped route stop sequences associated with it.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<BusLineDto>? busLines;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state & validation
    private bool showFormModal = false;
    private int? editingId = null;
    private int formBusNumber = 0;
    private string formOutboundTitleMm = "";
    private string formOutboundTitleEn = "";
    private string formReturnTitleMm = "";
    private string formReturnTitleEn = "";
    private bool formYpsAccepted = false;
    private string formValidationError = "";
    private string formBusNumberError = "";
    private string formOutboundError = "";

    // Delete Modal state
    private bool showDeleteModal = false;
    private int? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            busLines = await BusLineService.GetBusLinesAsync(pageNumber, pageSize, searchQuery);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch() { pageNumber = 1; await LoadData(); }
    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private void OpenCreateModal()
    {
        editingId = null;
        formBusNumber = 0;
        formOutboundTitleMm = "";
        formOutboundTitleEn = "";
        formReturnTitleMm = "";
        formReturnTitleEn = "";
        formYpsAccepted = false;
        formValidationError = "";
        formBusNumberError = "";
        formOutboundError = "";
        showFormModal = true;
    }

    private void OpenEditModal(BusLineDto item)
    {
        editingId = item.RouteId;
        formBusNumber = item.BusNumber;
        formOutboundTitleMm = item.OutboundTitleMm ?? "";
        formOutboundTitleEn = item.OutboundTitleEn ?? "";
        formReturnTitleMm = item.ReturnTitleMm ?? "";
        formReturnTitleEn = item.ReturnTitleEn ?? "";
        formYpsAccepted = item.IsYpsAccepted;
        formValidationError = "";
        formBusNumberError = "";
        formOutboundError = "";
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveBusLine()
    {
        formValidationError = "";
        formBusNumberError = "";
        formOutboundError = "";

        if (formBusNumber <= 0)
        {
            formBusNumberError = "Bus Number must be greater than 0.";
        }
        if (string.IsNullOrWhiteSpace(formOutboundTitleMm))
        {
            formOutboundError = "Outbound Title (MM) is required.";
        }

        if (!string.IsNullOrEmpty(formBusNumberError) || !string.IsNullOrEmpty(formOutboundError))
        {
            formValidationError = "Please fix validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateBusLineRequest(formBusNumber, formOutboundTitleMm, formOutboundTitleEn, formReturnTitleMm, formReturnTitleEn, formYpsAccepted);
                await BusLineService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess($"Bus Line {formBusNumber} updated successfully.");
            }
            else
            {
                var req = new CreateBusLineRequest(formBusNumber, formBusNumber, formOutboundTitleMm, formOutboundTitleEn, formReturnTitleMm, formReturnTitleEn, formYpsAccepted);
                await BusLineService.CreateAsync(req);
                Toast.ShowSuccess($"Bus Line {formBusNumber} created successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save bus line: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(BusLineDto item)
    {
        deletingId = item.RouteId;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await BusLineService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Bus line deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete bus line: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
