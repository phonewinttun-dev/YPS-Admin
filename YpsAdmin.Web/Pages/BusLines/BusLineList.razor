@page "/bus-lines"
@inject IBusService BusService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-card p-4 rounded-xl border border-border shadow-xs">
        <div>
            <h2 class="text-base font-semibold text-foreground tracking-tight">@Lang.GetText("NavBusLines")</h2>
            <p class="text-xs text-muted-foreground mt-0.5">Manage YBS transit buses, variant IDs, route directions, and YPS payment card acceptance.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleSearch"
                       placeholder="Search by bus number..."
                       aria-label="Search by bus number"
                       class="w-full h-9 pl-9 pr-3 text-sm border border-input rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary shadow-xs transition-all" />
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md" OnClick="OpenCreateModal">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("Add")
            </Button>
        </div>
    </div>

    <!-- Data Table & State Wrapper -->
    <div class="bg-card rounded-xl border border-border shadow-xs overflow-hidden">
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadData"
                   IsEmpty="@(buses == null || buses.Data == null || !buses.Data.Any())"
                   EmptyTitle="No buses found"
                   EmptyDescription="Try searching for a different bus number or create a new bus record.">
            <ChildContent>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-muted/40 border-b border-border text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                <th class="p-3.5">@Lang.GetText("BusNumber")</th>
                                <th class="p-3.5">@Lang.GetText("VariantId")</th>
                                <th class="p-3.5">@Lang.GetText("Direction")</th>
                                <th class="p-3.5 text-center">@Lang.GetText("YpsAccepted")</th>
                                <th class="p-3.5 text-right">@Lang.GetText("Actions")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @if (buses?.Data != null)
                            {
                                @foreach (var item in buses.Data)
                                {
                                    <tr class="hover:bg-accent/40 transition-colors">
                                        <td class="p-3.5 font-bold font-mono text-primary text-base">
                                            Bus @item.BusNumber
                                        </td>
                                        <td class="p-3.5 text-foreground">
                                            @if (!string.IsNullOrEmpty(item.VariantId))
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-muted text-foreground border border-border">
                                                    @item.VariantId
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-muted-foreground">Default</span>
                                            }
                                        </td>
                                        <td class="p-3.5">
                                            @if (item.IsReversed)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300">
                                                    @Lang.GetText("Return")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-900 border border-blue-200">
                                                    @Lang.GetText("Outbound")
                                                </span>
                                            }
                                        </td>
                                        <td class="p-3.5 text-center">
                                            @if (item.IsCardAccepted)
                                            {
                                                <CategoryBadge Text="@Lang.GetText("Yes")" Variant="CategoryBadge.BadgeVariant.YpsAccepted" ShowDot="true" />
                                            }
                                            else
                                            {
                                                <CategoryBadge Text="@Lang.GetText("No")" Variant="CategoryBadge.BadgeVariant.Outline" ShowDot="false" />
                                            }
                                        </td>
                                        <td class="p-3.5 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => OpenEditModal(item)">
                                                    @Lang.GetText("Edit")
                                                </Button>
                                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-destructive hover:bg-destructive/10 hover:text-destructive" OnClick="() => PromptDelete(item)">
                                                    @Lang.GetText("Delete")
                                                </Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (buses?.Pagination != null)
                {
                    <Pagination PageNumber="@pageNumber" TotalPages="@buses.Pagination.TotalPages" TotalCount="@buses.Pagination.TotalCount" PageSize="@pageSize" PageChanged="OnPageChanged" />
                }
            </ChildContent>
        </StateView>
    </div>
</div>

<!-- Create / Edit Form Modal -->
<ModalDialog IsOpen="@showFormModal"
             IsOpenChanged="v => showFormModal = v"
             Title="@(editingId.HasValue ? $"{Lang.GetText("Edit")} {Lang.GetText("NavBusLines")}" : $"{Lang.GetText("Add")} {Lang.GetText("NavBusLines")}")"
             Description="Enter bus line number, optional route variant ID, and configuration options.">
    <ChildContent>
        @if (!string.IsNullOrEmpty(formValidationError))
        {
            <div class="p-3 bg-destructive/10 border border-destructive/20 rounded-md text-xs text-destructive flex items-center gap-2" role="alert">
                <svg class="w-4 h-4 shrink-0 text-destructive" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>@formValidationError</span>
            </div>
        }

        <div class="space-y-3.5">
            <div>
                <label class="block text-xs font-medium text-foreground mb-1">@Lang.GetText("BusNumber") *</label>
                <input type="number" @bind="formBusNumber" min="1" class="w-full h-9 px-3 text-sm border rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary font-mono shadow-xs @(!string.IsNullOrEmpty(formBusNumberError) ? "border-destructive bg-destructive/5" : "border-input")" />
                @if (!string.IsNullOrEmpty(formBusNumberError))
                {
                    <p class="text-2xs text-destructive mt-1">@formBusNumberError</p>
                }
            </div>
            <div>
                <label class="block text-xs font-medium text-muted-foreground mb-1">@Lang.GetText("VariantId") (e.g. Main, Inbound, Express)</label>
                <input type="text" @bind="formVariantId" placeholder="Optional variant identifier" class="w-full h-9 px-3 text-sm border border-input rounded-md bg-card text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary font-mono shadow-xs" />
            </div>
            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" id="reversedCheck" @bind="formIsReversed" class="h-4 w-4 rounded border-input text-primary focus:ring-ring" />
                <label for="reversedCheck" class="text-sm font-medium text-foreground cursor-pointer select-none">@Lang.GetText("IsReversed")</label>
            </div>
            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="ypsCheck" @bind="formYpsAccepted" class="h-4 w-4 rounded border-input text-primary focus:ring-ring" />
                <label for="ypsCheck" class="text-sm font-medium text-foreground cursor-pointer select-none">@Lang.GetText("YpsAccepted")</label>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="CloseFormModal">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="SaveBus">
            @Lang.GetText("Save")
        </Button>
    </Footer>
</ModalDialog>

<!-- Delete Confirmation Modal -->
<ModalDialog IsOpen="@showDeleteModal"
             IsOpenChanged="v => showDeleteModal = v"
             Title="@Lang.GetText("ConfirmDeleteTitle")"
             Description="@Lang.GetText("ConfirmDeleteMessage")">
    <ChildContent>
        <p class="text-xs text-muted-foreground">Deleting this bus line will also remove any mapped route stop sequences associated with it.</p>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => showDeleteModal = false">
            @Lang.GetText("Cancel")
        </Button>
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" IsLoading="@isSaving" OnClick="ConfirmDelete">
            @Lang.GetText("Confirm")
        </Button>
    </Footer>
</ModalDialog>

@code {
    private PagedResult<BusDto>? buses;
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;

    private int pageNumber = 1;
    private int pageSize = 10;
    private string searchQuery = "";

    // Form Modal state & validation
    private bool showFormModal = false;
    private long? editingId = null;
    private long formBusNumber = 1;
    private string formVariantId = "";
    private bool formIsReversed = false;
    private bool formYpsAccepted = false;
    private string formValidationError = "";
    private string formBusNumberError = "";

    // Delete Modal state
    private bool showDeleteModal = false;
    private long? deletingId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            buses = await BusService.GetBusesAsync(pageNumber, pageSize, searchQuery);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch() { pageNumber = 1; await LoadData(); }
    private async Task OnPageChanged(int newPage) { pageNumber = newPage; await LoadData(); }

    private void OpenCreateModal()
    {
        editingId = null;
        formBusNumber = 1;
        formVariantId = "";
        formIsReversed = false;
        formYpsAccepted = false;
        formValidationError = "";
        formBusNumberError = "";
        showFormModal = true;
    }

    private void OpenEditModal(BusDto item)
    {
        editingId = item.Id;
        formBusNumber = item.BusNumber;
        formVariantId = item.VariantId ?? "";
        formIsReversed = item.IsReversed;
        formYpsAccepted = item.IsCardAccepted;
        formValidationError = "";
        formBusNumberError = "";
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveBus()
    {
        formValidationError = "";
        formBusNumberError = "";

        if (formBusNumber <= 0)
        {
            formBusNumberError = "Valid Bus Number is required.";
            formValidationError = "Please fix validation errors before saving.";
            return;
        }

        isSaving = true;
        try
        {
            if (editingId.HasValue)
            {
                var req = new UpdateBusRequest(formBusNumber, string.IsNullOrWhiteSpace(formVariantId) ? null : formVariantId.Trim(), formYpsAccepted, formIsReversed, false);
                await BusService.UpdateAsync(editingId.Value, req);
                Toast.ShowSuccess($"Bus {formBusNumber} updated successfully.");
            }
            else
            {
                var req = new CreateBusRequest(formBusNumber, string.IsNullOrWhiteSpace(formVariantId) ? null : formVariantId.Trim(), formYpsAccepted, formIsReversed);
                await BusService.CreateAsync(req);
                Toast.ShowSuccess($"Bus {formBusNumber} created successfully.");
            }
            showFormModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save bus: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(BusDto item)
    {
        deletingId = item.Id;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (!deletingId.HasValue) return;
        isSaving = true;
        try
        {
            await BusService.DeleteAsync(deletingId.Value);
            Toast.ShowSuccess("Bus deleted successfully.");
            showDeleteModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete bus: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
