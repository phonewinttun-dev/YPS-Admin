@namespace YpsAdmin.Web.Pages.RouteStops.Components
@inject LanguageService Lang

@if (Bus != null)
{
    <div class="bg-card p-4 rounded-xl border border-border shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2.5">
                <h3 class="text-base font-bold font-mono text-primary flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                    Bus @Bus.BusNumber
                </h3>
                @if (!string.IsNullOrEmpty(Bus.VariantId))
                {
                    <span class="px-2 py-0.5 rounded text-xs font-mono font-medium bg-muted text-foreground border border-border">
                        @Bus.VariantId
                    </span>
                }
                @if (Bus.IsReversed)
                {
                    <span class="px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300">
                        @Lang.GetText("Return")
                    </span>
                }
                else
                {
                    <span class="px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-900 border border-blue-200">
                        Forward
                    </span>
                }
                @if (Bus.IsCardAccepted)
                {
                    <CategoryBadge Text="YPS CARD" Variant="CategoryBadge.BadgeVariant.YpsAccepted" ShowDot="true" />
                }
            </div>
            <p class="text-xs text-muted-foreground">
                Configured route sequence & map path for this transit line.
            </p>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
            <div class="flex items-center gap-2 text-xs font-mono bg-muted/60 px-3 py-1.5 rounded-lg border border-border">
                <span class="text-muted-foreground">Assigned Stops:</span>
                <strong class="text-foreground font-bold">@StopCount</strong>
            </div>

            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" OnClick="TriggerAssignStops">
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @Lang.GetText("AssignStops")
            </Button>
        </div>
    </div>
}

@code {
    [Parameter] public BusDto? Bus { get; set; }
    [Parameter] public int StopCount { get; set; } = 0;
    [Parameter] public EventCallback OnAssignStopsClicked { get; set; }

    private async Task TriggerAssignStops()
    {
        if (OnAssignStopsClicked.HasDelegate)
        {
            await OnAssignStopsClicked.InvokeAsync();
        }
    }
}
