@page "/route-stops"
@inject IBusRouteService RouteStopService
@inject IBusStopService BusStopService
@inject IRegionService RegionService
@inject IToastService Toast
@inject LanguageService Lang

<div class="space-y-6">
    <!-- Bus Line Selector Bar -->
    <BusLineSelectorBar SelectedBusId="@selectedBusId" OnBusSelected="HandleBusSelected" />

    @if (selectedBusId > 0 && selectedBus != null)
    {
        <!-- Active Bus Line Card -->
        <RouteHeaderCard Bus="@selectedBus"
                         StopCount="@(fullRoute?.Stops?.Count ?? 0)"
                         OnAssignStopsClicked="OpenAssignModal" />

        <!-- Route Stop Sequence & Map View -->
        <StateView IsLoading="@isLoading"
                   HasError="@hasError"
                   ErrorMessage="@errorMessage"
                   OnRetry="LoadRoute"
                   IsEmpty="@(fullRoute == null || fullRoute.Stops == null || !fullRoute.Stops.Any())"
                   EmptyTitle="No route stops assigned"
                   EmptyDescription="Click 'Assign Stops' to configure the sequence of bus stops for this bus line.">
            <ChildContent>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Left: Interactive OpenStreetMap (7 Cols) -->
                    <div class="lg:col-span-7">
                        <RouteStopMap @ref="routeMapRef"
                                      Stops="@fullRoute?.Stops"
                                      HighlightedStopId="@highlightedStopId"
                                      OnStopMarkerClicked="HandleMapStopClicked"
                                      HeightClass="h-[520px]" />
                    </div>

                    <!-- Right: Ordered Stop Sequence List (5 Cols) -->
                    <div class="lg:col-span-5">
                        <RouteStopList Stops="@fullRoute?.Stops"
                                       SelectedStopId="@highlightedStopId"
                                       IsReordering="@isReordering"
                                       OnStopSelected="HandleListStopSelected"
                                       OnStopHovered="HandleListStopHovered"
                                       OnReorderRequested="HandleReorder"
                                       OnDragReordered="HandleDragReorder"
                                       OnRemoveRequested="HandleRemove" />
                    </div>
                </div>
            </ChildContent>
        </StateView>
    }
    else
    {
        <div class="bg-card rounded-xl border border-border p-12 text-center shadow-xs">
            <div class="w-12 h-12 rounded-full bg-muted flex items-center justify-center text-muted-foreground mx-auto mb-3">
                <svg class="w-6 h-6 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.818V8.049a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
            </div>
            <h3 class="text-base font-semibold text-foreground">Please select a bus line</h3>
            <p class="text-xs text-muted-foreground mt-1 max-w-sm mx-auto">
                Choose a bus line from the catalog above to view its live OpenStreetMap path and manage its stop sequence.
            </p>
        </div>
    }
</div>

<!-- Assign Bus Stops Modal with Dual List + Map View -->
<AssignStopsModal IsOpen="@showAssignModal"
                  IsOpenChanged="v => showAssignModal = v"
                  Bus="@selectedBus"
                  InitialSelectedStopIds="@assignedStopIds"
                  AllBusStops="@allBusStops"
                  Regions="@regions"
                  IsSaving="@isSaving"
                  OnSave="SaveAssignedStops" />

@code {
    private long selectedBusId = 0;
    private BusDto? selectedBus;
    private FullRouteResponseDto? fullRoute;
    private bool isLoading = false;
    private bool hasError = false;
    private string? errorMessage = null;
    private bool isSaving = false;
    private bool isReordering = false;

    private long? highlightedStopId = null;
    private RouteStopMap? routeMapRef;

    // Modal state
    private bool showAssignModal = false;
    private List<BusStopDto>? allBusStops;
    private List<RegionDto>? regions;

    private IEnumerable<long> assignedStopIds => fullRoute?.Stops?.Select(s => s.BusStopId) ?? Enumerable.Empty<long>();

    protected override async Task OnInitializedAsync()
    {
        var stopsTask = BusStopService.GetBusStopsAsync(1, 500, null);
        var regionsTask = RegionService.GetRegionsAsync(1, 200, null);

        await Task.WhenAll(stopsTask, regionsTask);

        var stopsRes = await stopsTask;
        if (stopsRes?.Data != null) allBusStops = stopsRes.Data;

        var regionsRes = await regionsTask;
        if (regionsRes?.Data != null) regions = regionsRes.Data;
    }

    private async Task HandleBusSelected(BusDto bus)
    {
        selectedBusId = bus.Id;
        selectedBus = bus;
        highlightedStopId = null;
        await LoadRoute();
    }

    private async Task LoadRoute()
    {
        if (selectedBusId <= 0) return;
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            var res = await RouteStopService.GetFullRouteAsync(selectedBusId);
            if (res != null && res.IsSuccess)
            {
                fullRoute = res.Data;
            }
            else
            {
                hasError = true;
                errorMessage = res?.Message ?? "Failed to load route stops.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleListStopSelected(long stopId)
    {
        highlightedStopId = stopId;
        if (routeMapRef != null)
        {
            await routeMapRef.HighlightStopAsync(stopId);
        }
    }

    private async Task HandleListStopHovered(long stopId)
    {
        highlightedStopId = stopId;
    }

    private void HandleMapStopClicked(long stopId)
    {
        highlightedStopId = stopId;
    }

    private async Task HandleDragReorder((int SourceIndex, int TargetIndex) args)
    {
        if (fullRoute?.Stops == null || isReordering) return;
        if (args.SourceIndex < 0 || args.SourceIndex >= fullRoute.Stops.Count ||
            args.TargetIndex < 0 || args.TargetIndex >= fullRoute.Stops.Count ||
            args.SourceIndex == args.TargetIndex) return;

        isReordering = true;

        // Clone current state for rollback if network/database fails
        var backupList = fullRoute.Stops.ToList();

        // Optimistically update list in memory
        var list = new List<BusRouteStopItemDto>(fullRoute.Stops);
        var movedItem = list[args.SourceIndex];
        list.RemoveAt(args.SourceIndex);
        list.Insert(args.TargetIndex, movedItem);

        // Sequentially update StopOrder in memory using record 'with' expression
        for (int i = 0; i < list.Count; i++)
        {
            list[i] = list[i] with { StopOrder = i + 1 };
        }

        fullRoute = fullRoute with { Stops = list };
        StateHasChanged();

        try
        {
            var items = list.Select((x, idx) =>
            {
                var oldStop = backupList.FirstOrDefault(b => b.BusStopId == x.BusStopId);
                return new ReorderBusRouteItem(x.BusStopId, oldStop?.StopOrder ?? (idx + 1), idx + 1);
            }).ToList();

            var req = new ReorderBusRoutesRequest(selectedBusId, items);
            var res = await RouteStopService.ReorderRouteStopsAsync(req);

            if (res != null && res.IsSuccess)
            {
                Toast.ShowSuccess(Lang.GetText("StopSequenceUpdated"));
            }
            else
            {
                fullRoute = fullRoute with { Stops = backupList };
                Toast.ShowError(res?.Message ?? Lang.GetText("Error"));
            }
        }
        catch (Exception ex)
        {
            fullRoute = fullRoute with { Stops = backupList };
            Toast.ShowError($"{Lang.GetText("Error")}: {ex.Message}");
        }
        finally
        {
            isReordering = false;
            StateHasChanged();
        }
    }

    private async Task HandleReorder((int CurrentIndex, int Delta) args)
    {
        if (fullRoute?.Stops == null || isReordering) return;
        int targetIndex = args.CurrentIndex + args.Delta;
        if (targetIndex < 0 || targetIndex >= fullRoute.Stops.Count) return;

        await HandleDragReorder((args.CurrentIndex, targetIndex));
    }

    private async Task HandleRemove(int stopOrder)
    {
        try
        {
            await RouteStopService.DeleteRouteStopAsync(selectedBusId, stopOrder);
            Toast.ShowSuccess("Stop removed from route.");
            await LoadRoute();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to remove stop: {ex.Message}");
        }
    }

    private void OpenAssignModal()
    {
        showAssignModal = true;
    }

    private async Task SaveAssignedStops(List<long> stopIds)
    {
        isSaving = true;
        try
        {
            var items = stopIds.Select((sId, idx) => new AssignBusRouteStopItem(sId, idx + 1)).ToList();
            var req = new AssignBusRoutesRequest(selectedBusId, items);
            await RouteStopService.AssignRouteStopsAsync(req);
            Toast.ShowSuccess("Route stops sequence updated.");
            showAssignModal = false;
            await LoadRoute();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to assign stops: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
