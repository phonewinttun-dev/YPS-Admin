@page "/not-found"
@layout MainLayout

<div class="min-h-[400px] flex items-center justify-center p-6">
    <div class="text-center max-w-md bg-white border border-outline-variant rounded-lg p-8 shadow-2xs space-y-4">
        <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-tertiary mx-auto">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        </div>
        <div class="space-y-1">
            <h2 class="text-lg font-bold text-on-surface">Page Not Found</h2>
            <p class="text-xs text-tertiary">Sorry, the page or resource you are looking for does not exist or has been moved.</p>
        </div>
        <div class="pt-2">
            <a href="bus-lines">
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Md">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    Back to Bus Lines
                </Button>
            </a>
        </div>
    </div>
</div>